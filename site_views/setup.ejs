                    <%
                        function addViewBox(svg) {
                            if (!svg) {
                                return;
                            }

                            if (!svg.includes("viewBox")) {
                                var width, height;

                                var wArr = svg.match(/width="(.*?)"/i)
                                if (wArr && wArr.length) {
                                    width = wArr[1];
                                }
                                
                                var hArr = svg.match(/height="(.*?)"/i);
                                if (hArr && hArr.length) {
                                    height = hArr[1]
                                }

                                if (width && height) {
                                    svg = svg.replace("height=", `height="${height}" viewBox="0 0 ${width} ${height}"`);
                                }
                            }

                            return svg;
                        }
