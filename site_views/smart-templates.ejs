            function isAllowedDownload(file_name) {
                var plan_name = <%- JSON.stringify(plan_name) %>
                var payment_failed = <%- JSON.stringify(payment_failed) %>

                return (plan_name && plan_name !== "Free" && !payment_failed) || file_name.includes("_free");
            }

