<%- include('partials/header', {async: true}); %>
<link rel="stylesheet" href="/static/css/polotno.css?<%=Date.now()%>" />
<link
  href="https://unpkg.com/@blueprintjs/icons@4/lib/css/blueprint-icons.css"
  rel="stylesheet"
/>
<link
  href="https://unpkg.com/@blueprintjs/popover2@1/lib/css/blueprint-popover2.css"
  rel="stylesheet"
/>
<script type="text/javascript" src="/static/js/polotno.js?<%=Date.now()%>"></script>
<script type="text/javascript" src="/static/js/polotno-blueprint-1.js?<%=Date.now()%>"></script>
<script type="text/javascript" src="/static/js/polotno-blueprint-2.js?<%=Date.now()%>"></script>
<div style="display: flex; flex-direction: row; width: 100%; height: 100%">
  <%- include('partials/nav', {async: true}); %>
  <div id="editor">
    <div class="page-title-container">
      <h2 class="page-title" style="z-index: 150">
        Editor<span class="text-primary">.</span>
      </h2>
    </div>
  </div>
  <script>
    window.onload = () => {
      PrettySmartEditor.mountEditor(document.getElementById("editor"), {
        mode: "standalone",
        email: "<%= user.email %>",
        designId: "<%= templateId %>",
        additional: JSON.parse(<%- JSON.stringify(additional) %>),
      })
    }
  </script>
</div>
