<body>
  <% if (typeof infobox !== "undefined" && false) { %>
  <div class="info-box df aic ffp fs13">
    <p class="mb-0"><%= infobox.text %> <a href="<%= infobox.button.link %>"><%= infobox.button.text %></a></p>
    <div class="df acc mla"><i class="fa-solid fa-xmark"></i></div>
  </div>
  <% } %>
  <div class="clip-header">
    <div class="clip-row">
      <button class="dropdown dropdown-colors" onclick="openColorPicker()">
        <div class="color-primary" style="background-color: <%= user.account.brand.colors.primary || '#1A428A' %>">
          <div class="color-secondary" style="background-color: <%= user.account.brand.colors.secondary || '#D5BA8C' %>"></div>
        </div>
        <p>Colors</p>
        <i class="fa-solid fa-chevron-down arrow"></i>
      </button>
      <button class="dropdown dropdown-fonts" onclick="openFontPicker()">
        <div class="font-icon">
          <i class="fa-solid fa-font-case fa-sm"></i>
        </div>
        <p>Fonts</p>
        <i class="fa-solid fa-chevron-down arrow"></i>
        <!-- <input id="font-picker" hidden type="hidden" name="Regular" class="google_font" value="<%= user.account.brand.fonts && brand.fonts.Regular ? user.account.brand.fonts.Regular.value : '' %>" placeholder="Search Google Fonts" class="" /> -->
        <!-- <button class="dropdown-item font-button-item" value="poppins">Poppins</button> -->
      </button>

      <!-- <div class="dropdown-menu dropdown-menu-right">
      <button class="dropdown-item font-button-item" style="font-family: 'Poppins';" value="poppins">Poppins</button>
      <button class="dropdown-item font-button-item" style="font-family: 'Times New Roman', Times, serif;" value="times_new_roman">Times New Roman</button>
      <button class="dropdown-item font-button-item" style="font-family: Arial, Helvetica, sans-serif;" value="helvetica">Helvetica</button>
    </div> -->

      <!-- <button class="update-button"><i class="fa-solid fa-arrows-rotate"></i><p>Update</p></button> -->
    </div>
    <div class="clip-row" style="justify-content: flex-end; margin-right: 10px;">
      <button onclick="<%= !user || !user.account || (!user.account.brand_email && !user.email) ? 'openLoginPopup();' : 'openProfilePopup();' %>" class="clip-button user-button"><i class="fa-solid fa-user"></i></button>
      <button onclick="openPlansPopup()" class="clip-button plan-button"><i class="fa-solid fa-coins"></i>Buy credits</button>
    </div>
  </div>
  <%- include('./color-picker-popup', {async: true,showLock:true}); %>
  <%- include('./profile-popup', {async: true}); %>
  <%- include('./login-popup', {async: true}); %>
  <%- include('./signup-popup', {async: true}); %>
  <%- include('./plans-popup', {async: true}); %>
  <%- include('./font-picker-popup', {async: true}); %>

  <script>
    function openColorPicker() {
      $("#colorPicker").removeClass("d-none")
    }

    function closeColorPicker() {
      $("#colorPicker").addClass("d-none")
    }

    function openFontPicker() {
      $("#fontPicker").removeClass("d-none");
      // $('.google_font').fontpicker('show');
    }

    function closeFontPicker() {
      $("#fontPicker").addClass("d-none");
      // $('.google_font').fontpicker('hide');
    }

    function openProfilePopup() {
      $("#profilePopup").removeClass("d-none")
    }

    function closeProfilePopup() {
      $("#profilePopup").addClass("d-none")
    }

    function openLoginPopup() {
      $("#loginPopup").removeClass("d-none")
    }

    function closeLoginPopup() {
      $("#loginPopup").addClass("d-none")
    }

    function openSignupPopup() {
      $("#signupPopup").removeClass("d-none")
    }

    function closeSignupPopup() {
      $("#signupPopup").addClass("d-none")
    }

    function toggleSignupPopup() {
      $("#loginPopup").addClass("d-none")
      $("#signupPopup").removeClass("d-none")
    }

    function toggleLoginPopup() {
      $("#signupPopup").addClass("d-none")
      $("#loginPopup").removeClass("d-none")
    }

    function openPlansPopup() {
      $("#plansPopup").removeClass("d-none")
    }

    function closePlansPopup() {
      $("#plansPopup").addClass("d-none")
    }
  </script>