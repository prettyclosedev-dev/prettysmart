<div
  data-template="<%=template.id%>"
  data-export
  class="template d-block rounded"
  original_title="<%= template.name %>"
  title="<%=template.name ? template.name.replace('_free','') : '';%>"
>
  <img
    src="<%=template.preview%>"
    alt=""
    class="rounded LoNotSensitive"
  />
  <% if (typeof showNewLoader != "undefined" && showNewLoader === true) { %> <%-
  include('./template-loader-new', {async: true}); %> <% } else { %> <%-
  include('./template-loader', {async:true}); %> <% } %>
</div>
