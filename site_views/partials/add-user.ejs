<div class="new-popup-wrapper add-user">
    <div class="overlay"></div>
    <div class="new-popup">
        <div class="df aic new-popup-header" style="border-color:#84B9E0">
            <p class="fs30 title" > 
                <% if(user_form._id){ %>
                    <%= user_form.name %>
                <% }else{ %>
                    New User
                <% } %>
            </p>
            <div class="df acc mla close-button pointer"  onclick="location.href='/settings/account'">
                <i class="fa-solid fa-xmark" ></i>
            </div>
        </div>

        <div class="new-popup-content">    
                <form class="user-form" action="/account/users/<%=user_form._id ? user_form._id : 'new'%>" method="post">
                    <div class="text-danger text-center" data-field="user"></div>
                        <div class="row">
                            <div class="col-12 col-lg-6">
                                <div class="input-wrapper">
                                    <div class="label">
                                        First Name
                                    </div>                          
                                    <input type="text" name="first_name" class="form-control" value="<%= user_form.first_name %>">
                                </div>
                            </div>
                            <div class="col-12 col-lg-6">
                                <div class="input-wrapper">
                                    <div class="label">
                                        Last Name
                                    </div>             
                                    <input type="text" name="last_name" class="form-control" value="<%= user_form.last_name %>">
                                </div>
                            </div>
                        </div>

                         <div class="row">
                            <div class="col-12 col-lg-6">
                                <div class="input-wrapper">
                                    <div class="label">
                                        Title
                                    </div>                          
                                    <input type="text" name="user_title" class="form-control" value="<%= user_form.user_title %>">
                                </div>
                            </div>
                            <div class="col-12 col-lg-6">
                                <div class="input-wrapper">
                                    <div class="label">
                                        Additional
                                    </div>             
                                    <input type="text" name="user_additional" class="form-control" value="<%= user_form.user_additional %>">
                                </div>
                            </div>
                        </div>  

                        <div class="row">
                            <div class="col-12 col-lg-6">
                                <div class="input-wrapper">
                                    <div class="label">
                                        Email
                                    </div>             
                                        <input type="email" name="email" class="form-control" value="<%= user_form.email %>" <%= user_form._id ? 'readonly' : '' %>>
                                    <div class="text-danger" data-field="email"></div> 
                                </div> 
                            </div>

                            <div class="col-12 col-lg-6">
                                <div class="input-wrapper">
                                    <div class="label">
                                        Phone
                                    </div>             
                                    <input type="tel" name="phone" class="form-control" value="<%= user_form.phone %>">
                                    <div class="text-danger" data-field="phone"></div> 
                                </div> 
                            </div>
                        </div>
                        <% if(user.role === 'owner'){ %>
                            <div class="row">
                                <div class="col-12 col-lg-6">
                                    <div class="my-3">
                                        <div class="text-primary">
                                            Role
                                        </div>
                                        <div class="fs22 font-weight-light">    
                                            <select name="role" class="custom-select" value="<%= user_form.role %>">
                                                <option value="owner" <%= user_form.role === 'owner' ? 'selected' : '' %>>Owner</option>
                                                <option value="admin" <%= user_form.role === 'admin' ? 'selected' : '' %>>Admin</option>
                                                <option value="user" <%= user_form.role === 'user' ? 'selected' : '' %>>User</option>
                                            </select>            
                                        </div>
                                    </div>
                                </div>
                                <div class="col-12 col-lg-6">
                                    <div class="my-3">
                                        <div class="text-primary">
                                            Avatar
                                        </div>
                                        <label class="upload-button" for="avatar-img">Select file <i class="fa-solid fa-upload"></i></label>
                                        <input style="display:none;" id="avatar-img" onchange="uploadAvatar(event)" type="file" name="avatar" accept="image/*" hidden="true" />
                                        <div class="file-label" id="selected-file-label"></div>
                                    </div>
                                </div>
                            </div>
                        <% } else { %>
                            <div class="row">
                                <div class="col-12 col-lg-6">
                                    <div class="my-3">
                                        <div class="text-primary">
                                            Avatar
                                        </div>
                                        <label class="upload-button" for="avatar-img">Select file <i class="fa-solid fa-upload"></i></label>
                                        <input style="display:none;" id="avatar-img" onchange="uploadAvatar(event)" type="file" name="avatar" accept="image/*" hidden="true" />
                                        <div class="file-label" id="selected-file-label"></div>
                                    </div>
                                </div>
                            </div>
                         <% } %>
                        <% if(!user_form._id){ %>
                            <div class="row">
                                <div class="col-12 col-lg-6">
                                    <div class="input-wrapper">
                                        <div class="label">
                                            Password
                                        </div>            
                                        <input type="password" name="password" class="form-control">
                                    </div>
                                </div>
                            </div>
                        <% } %>
                        <div class="text-center">
                            <button type="submit" class="btn btn-primary badge-pill px-5 mt-4">Save User</button>
                        </div>

                        <div class="form-loader">
                            <svg version="1.1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" x="0px" y="0px"
                                viewBox="0 0 100 100" enable-background="new 0 0 100 100" xml:space="preserve">
                                <rect fill="none" stroke="#F7176D" stroke-width="4" x="25" y="25" width="50" height="50">
                                    <animateTransform attributeName="transform" dur="0.5s" from="0 50 50" to="180 50 50" type="rotate"
                                        id="strokeBox" attributeType="XML" begin="rectBox.end" />
                                </rect>
                                <rect x="27" y="27" fill="#F7176D" width="46" height="50">
                                    <animate attributeName="height" dur="1.3s" attributeType="XML" from="50" to="0" id="rectBox"
                                        fill="freeze" begin="0s;strokeBox.end" />
                                </rect>
                            </svg>
                        </div>
                    </div>
                </form>
        </div>
    </div>
</div>

<script>
    function uploadAvatar(e) {
        let $container = $("#selected-file-label")
        $container.empty()
        Array.from(e.target.files).map(file=> {
            $container.append(`<p>${file.name}</p>`)
        })

        var $file = $("#avatar-img");
        if ($file.length && $file[0].files.length) {
            var type = $file.data("file-type"),
                name = $file.attr("name"),
                file = $file[0].files[0],
                data = new FormData();

            data.append(name, file);
            data.append("name", name);

            var userId = <%- JSON.stringify(user_form._id) %>

            $.ajax({
                url: "/settings/account/upload-avatar/" + userId,
                data: data,
                type: "POST",
                contentType: false,
                processData: false,
                success: function (res) {
                    console.log("SUCCESS", res);
                    if (!res.success) {
                        alert(res.error || "Failed to upload avatar!")
                    }
                },
                error: function (err) {
                    console.log("ERROR", err);
                    alert(JSON.stringify(err));
                },
            });
        }
    }

    $(document).on('submit', '.user-form', function() {
        var $form = $(this),
            data = $form.serializeArray();

        // Show the loader
        $form.find('.form-loader').addClass('d-flex');

        // Clear any previous error messages
        $('[data-field]').text('');

        $.post($form.attr('action'), $.param(data), function(res) {
            console.log("Response: ", res);
            if (res && res.success) {
                window.location.href = "/settings/account"; // Redirect on success
            } else {
                // Display any errors returned by the server
                if (res.errors && Array.isArray(res.errors)) {
                    res.errors.forEach(function(error) {
                        $('[data-field="'+ error.param +'"]').text(error.msg);
                    });
                } else if (res.error) {
                    alert(res.error.message || "An unexpected error occurred.");
                }
            }
        }).fail(function(res) {
            console.log(res);
            // Handle server-side validation errors or other issues
            if (res.responseJSON && res.responseJSON.errors) {
                res.responseJSON.errors.forEach(function(error) {
                    $('[data-field="'+ error.param +'"]').text(error.msg);
                });
            } else if (res.responseJSON && res.responseJSON.error) {
                $('[data-field="signup"]').text(res.responseJSON.error.message);
            } else {                
                $('[data-field="signup"]').text("An unexpected error occurred.");
            }
        }).always(function() {
            // Always remove the loader, regardless of success or failure
            $form.find('.form-loader').removeClass('d-flex');
        });

        return false; // Prevent form submission from reloading the page
    });

</script>