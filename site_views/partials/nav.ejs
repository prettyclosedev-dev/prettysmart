      <script type="text/javascript">
        {
          let sideBar = document.querySelector(".nav-wrapper");
          let arrowCollapse = document.querySelector("#logo-name__icon_id");
          let infoBox = document.querySelector(".info-box")

          // let overlay = document.querySelector(".overlay");
          arrowCollapse.onclick = () => {
            sideBar.classList.toggle("collapsed");
            arrowCollapse.classList.toggle("collapsed");
            if (infoBox) {
              infoBox.classList.toggle("collapsed")
            }

            // overlay.classList.toggle("d-none");
            if (arrowCollapse.classList.contains("collapsed")) {
              // window.navigationCollapsed = true;
              arrowCollapse.classList =
                "fa-light fa-arrow-right-from-line logo-name__icon collapsed";
            } else {
              // window.navigationCollapsed = false;
              arrowCollapse.classList =
                "fa-light fa-arrow-left-from-line logo-name__icon";
            }
          };
        }
      </script>
      <script>
        function navClicked() {

          topbar.config({
            barThickness: 7,
            barColors: {
              '0': '#db3965',
              '1.0': '#db3965'
            },
          })

          topbar.show()
        }

        $("a").click(function() {
          $(".tooltip").hide();
        });

        $(".link-wrapper, .action-wrapper").hover(
          function() {
            if ($(".nav-wrapper").hasClass("collapsed")) {
              var frame = $(this).offset();
              var txt = $(this).find(".icon-text").html();
              if (!txt) {
                txt = $(this).find(".action-icon-text").html();
              }
              var left = 60;
              $(".tooltip")
                .css("left", frame.left + $(this).width() + left)
                .css("top", frame.top + $(this).height() / 2);
              $(".tooltip").fadeIn();
              $(".tooltip").html(txt);
            }
          },
          function() {
            $(".tooltip").hide();
          }
        );

        function toggleMobileNav() {
          $(".all-wrpr").toggleClass("mobile-hide");
          $(".mobile-nav-opener").toggleClass("mobile-hide");
          $(".overlay").toggleClass("mobile-hide");
        }
      </script>
