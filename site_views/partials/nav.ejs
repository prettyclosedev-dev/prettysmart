          function userAccess(page) {
            return user.account.pages.map(p => p.name).includes(page)
          }
          
          function isModuleLocked() {
            console.log("checking if brand has been setup completely...")
            
            if(!user.phone && !user.account.brand_phone) {
              console.error("no phone number setup!")
              return true;
            }

             if(!user.account.name) {
              console.error("no company name setup!")
              return true;
            }
            
            
            if(!user.account.brand) {
              console.error("no account brand setup!")
              return true;
            }
            
            if(!user.account.brand.logos) {
              console.error("no logos setup!")
              return true;
            }
            
            if(!user.account.brand.logos.logo) {
              console.error("no logo setup!")
              return true;
            }
            
            return false
          }
        %>

          <% if(isModuleLocked()) { %>
