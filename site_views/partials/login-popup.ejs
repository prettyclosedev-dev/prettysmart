<div id="loginPopup" class="new-popup-wrapper d-none gt misc">
  <link rel="stylesheet" href="/static/css/login-popup.css?<%=Date.now()%>" />
  <div class="overlay"></div>
  <div class="new-popup">
    <div class="login-primary-wrapper">
      <div class="login-sub-wrapper">
        <div class="df aic new-popup-header" style="border-bottom: none">
          <div>
            <p class="fs30 title">Login</p>
            <p class="text-center fs16">
              Don't have an account? <button class="a-button" onclick="toggleSignupPopup()">Sign Up</button>
            </p>
          </div>
          <div
            class="df acc mla close-button pointer close"
            style="--bg-color: #84b9e01a %>; --bg-color-hover: #84b9e033 %>"
            onclick="closeLoginPopup()"
          >
            <i
              class="fa-regular fa-xmark"
              style="color: <%= user.account.brand.colors.primary %>"
            ></i>
          </div>
        </div>

        <div class="df login-wrapper">
          <form
            action="/login"
            method="post"
            class="mx-auto login-form position-relative"
          >
            <div class="text-danger text-center" data-field="login"></div>
            <div class="mb-4">
              <div class="input-group input-group-lg">
                <div class="input-group-prepend">
                  <span class="input-group-text bg-white px-3">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="16.938"
                      height="17.609"
                      viewBox="0 0 16.938 17.609"
                    >
                      <path
                        d="M3291.03,2260.093a10.087,10.087,0,0,1,.159-1.291c.063-.3.116-.526.146-.624.017-.054.049-.164.073-.245a7.869,7.869,0,0,1,.3-.808l.153-.331A8.536,8.536,0,0,1,3294,2254a9.378,9.378,0,0,1,1.1-.8,8.1,8.1,0,0,1,1.248-.619c.148-.058.286-.113.306-.122s.119-.042.221-.072.228-.069.281-.087a8.419,8.419,0,0,1,4.675,0c.054.018.18.057.281.087s.2.062.22.072.158.065.306.122A8.333,8.333,0,0,1,3305,2254a8.543,8.543,0,0,1,2.145,2.792c.065.142.134.29.153.331a7.87,7.87,0,0,1,.3.808c.023.081.056.191.073.245.03.1.073.282.144.612a10.051,10.051,0,0,1,.162,1.3v.08H3291.03Zm8.04-9.342a4.317,4.317,0,0,1-1.353-.386,4.175,4.175,0,0,1-2.18-2.614,4.486,4.486,0,0,1,0-2.179,4.154,4.154,0,0,1,2.873-2.873,4.488,4.488,0,0,1,2.179,0,4.154,4.154,0,0,1,2.873,2.873,4.486,4.486,0,0,1,0,2.179,4.151,4.151,0,0,1-2.886,2.876A4.625,4.625,0,0,1,3299.07,2250.75Z"
                        transform="translate(-3291.03 -2242.564)"
                        fill="#b6bacb"
                      />
                    </svg>
                  </span>
                </div>
                <input
                  type="email"
                  name="email"
                  placeholder="Email"
                  class="form-control"
                />
              </div>
            </div>
            <div class="mb-4">
              <div class="input-group input-group-lg">
                <div class="input-group-prepend">
                  <span class="input-group-text bg-white px-3">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="13.806"
                      height="17.609"
                      viewBox="0 0 13.806 17.609"
                    >
                      <g transform="translate(0 0)">
                        <path
                          d="M12.506,7.234V5.6A5.6,5.6,0,0,0,1.3,5.6V7.234A1.6,1.6,0,0,0,0,8.8v7.2a1.6,1.6,0,0,0,1.6,1.6H12.206a1.6,1.6,0,0,0,1.6-1.6V8.8A1.6,1.6,0,0,0,12.506,7.234Zm-5,5.6v2.37H6.3v-2.37a1.6,1.6,0,1,1,1.2,0ZM10.1,7.2H3.7V5.6a3.2,3.2,0,1,1,6.4,0Z"
                          transform="translate(0 0)"
                          fill="#b6bacb"
                        />
                      </g>
                    </svg>
                  </span>
                </div>
                <input
                  type="password"
                  name="password"
                  placeholder="Password"
                  class="form-control"
                />
              </div>
            </div>
            <div>
              <input
                type="submit"
                value="Log In"
                class="btn btn-block btn-primary"
              />
            </div>
            <div class="text-right pt-2">
              <a href="/forgot">Reset Password</a>
            </div>
            <div class="form-loader">
              <svg
                version="1.1"
                xmlns="http://www.w3.org/2000/svg"
                xmlns:xlink="http://www.w3.org/1999/xlink"
                x="0px"
                y="0px"
                viewBox="0 0 100 100"
                enable-background="new 0 0 100 100"
                xml:space="preserve"
              >
                <rect
                  fill="none"
                  stroke="#F7176D"
                  stroke-width="4"
                  x="25"
                  y="25"
                  width="50"
                  height="50"
                >
                  <animateTransform
                    attributeName="transform"
                    dur="0.5s"
                    from="0 50 50"
                    to="180 50 50"
                    type="rotate"
                    id="strokeBox"
                    attributeType="XML"
                    begin="rectBox.end"
                  />
                </rect>
                <rect x="27" y="27" fill="#F7176D" width="46" height="50">
                  <animate
                    attributeName="height"
                    dur="1.3s"
                    attributeType="XML"
                    from="50"
                    to="0"
                    id="rectBox"
                    fill="freeze"
                    begin="0s;strokeBox.end"
                  />
                </rect>
              </svg>
            </div>
          </form>

        <div class="text-center px-3">
            * By logging in, you agree to our <a href="/pages/term-of-use">Terms of Use</a> and to receive clyps emails & updates
            <br class="d-none d-lg-block">
            and acknowledge that you read our <a href="/pages/privacy-policy">Privacy Policy.</a>
        </div>
        </div>
      </div>
    </div>
  </div>
</div>
<script>
  var user_location;

  $(document).ready(function () {
    $.ajax({
      url: "https://geolocation-db.com/jsonp",
      jsonpCallback: "callback",
      dataType: "jsonp",
      success: function (location) {
        user_location = location;
        // $('#country').html(location.country_name);
        // $('#state').html(location.state);
        // $('#city').html(location.city);
        // $('#latitude').html(location.latitude);
        // $('#longitude').html(location.longitude);
        // $('#ip').html(location.IPv4);
      },
    });
  });

  $(document).on("submit", ".login-form", function () {
    var $form = $(this),
      data = $form.serializeArray();

    if (user_location) {
      const { country_name, state, city } = user_location;
      if (country_name || state || city) {
        data = [
          ...data,
          { name: "country", value: country_name },
          { name: "state", value: state },
          { name: "city", value: city },
        ];
      }
    }

    $form.find(".form-loader").addClass("d-flex");
    $.post($form.attr("action"), $.param(data), function (res) {
      $form.find(".form-loader").removeClass("d-flex");
      if (res.route) {
        closeLoginPopup();
        window.location.reload()
      } else if (res.error) {
        alert(JSON.stringify(res.error));
      } else {
        alert("Failed to login!")
      }
    }).fail(function (res) {
      if (res.responseJSON && res.responseJSON.errors) {
        res.responseJSON.errors.forEach(function (error) {
          $('[data-field="' + error.param + '"]').text(error.msg);
        });
      } else if (res.responseJSON && res.responseJSON.error) {
        $('[data-field="signup"]').text(res.responseJSON.error.message);
      } else {
        $('[data-field="signup"]').text(res.error || res.responseText);
      }
      $form.find(".form-loader").removeClass("d-flex");
    });

    return false;
  });
</script>
