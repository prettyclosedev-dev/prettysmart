      <script>
        function navClicked() {

          topbar.config({
            barThickness: 7,
            barColors: {
              '0': '#db3965',
              '1.0': '#db3965'
            },
          })

          topbar.show()
        }

        $("a").click(function() {
          $(".tooltip").hide();
        });

        $(".link-wrapper, .action-wrapper").hover(
          function() {
            if ($(".nav-wrapper").hasClass("collapsed")) {
              var frame = $(this).offset();
              var txt = $(this).find(".icon-text").html();
              if (!txt) {
                txt = $(this).find(".action-icon-text").html();
              }
              var left = 60;
              $(".tooltip")
                .css("left", frame.left + $(this).width() + left)
                .css("top", frame.top + $(this).height() / 2);
              $(".tooltip").fadeIn();
              $(".tooltip").html(txt);
            }
          },
          function() {
            $(".tooltip").hide();
          }
        );

        function toggleMobileNav() {
          $(".all-wrpr").toggleClass("mobile-hide");
          $(".mobile-nav-opener").toggleClass("mobile-hide");
          $(".overlay").toggleClass("mobile-hide");
        }
      </script>

      <script>
        var generates_left = <%- JSON.stringify(typeof generates_left !== "undefined" ? generates_left : 0) %>;

        function generateClyps() {
          if (!generates_left) {
            openPlansPopup();
            return
          }

          if ($('.list-wrapper').hasClass("d-none")) {
            $(".page-content").loading();
          }

          $('.list-wrapper').load('/' + ' #templates_container', function() {
            $(".page-content").stopLoading();
            $(".list-wrapper").removeClass("d-none")

            getCustomization({
              runAI: true,
              row_class_name: 'Clyps'
            }, null, function(opts) {
              if (opts.success) {
                swiper = new Swiper(".swiper", {
                  slidesPerView: "auto",
                  spaceBetween: 14,
                  mousewheel: true,
                  observer: true,
                  observeParents: true,
                  rebuildOnUpdate: true,
                  navigation: {
                    nextEl: ".swiper-button-next",
                    prevEl: ".swiper-button-prev",
                  },
                });

                $(".item-wrapper").hover(function() {
                  $(".swiper-button-prev").removeClass("hidden");
                  $(".swiper-button-next").removeClass("hidden");
                }, function() {
                  $(".swiper-button-prev").addClass("hidden");
                  $(".swiper-button-next").addClass("hidden");
                });

                $.post("/add-usage", {
                  input: $(".ai_field").val()
                }).then(function(success) {
                  if (success?.credits?.generates) {
                    generates_left = success?.credits?.generates;
                    $(".credits-left").text(success?.credits?.generates + ' credits left')
                  }
                }).catch(function(error) {
                  console.log(error)
                });

                $.post("/brand/mix-colors").then(function (success) {
                  console.log(success)

                  if (success && success.results && success.results) {
                      var resPallete = success.results[success.results.length - 1];
                      if (resPallete && resPallete.palette && resPallete.palette.length > 1) {
                        $(".color-primary").css("background-color", resPallete.palette[0])
                        $(".color-secondary").css("background-color", resPallete.palette[1])

                        $("#primary").css("background-color", resPallete.palette[0])
                        $("#secondary").css("background-color", resPallete.palette[1])

                        $("#primary").attr("value", resPallete.palette[0])
                        $("#secondary").attr("value", resPallete.palette[1])

                        $("#primary").attr("data-secondary-color", resPallete.palette[0])
                        $("#secondary").attr("data-secondary-color", resPallete.palette[1])
                      }
                    }
                }).catch(function (e) {
                  console.log(e)
                })
              }
            });
          });
        }
      </script>
    </div>
    <div class="tooltip"></div>
  </div>
</div>