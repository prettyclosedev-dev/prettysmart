  <div class="all-wrpr mobile-hide">
    <div class="overlay mobile-hide" onclick="toggleMobileNav()"></div>
    <div class="nav-wrapper">
      <div class="df logo-wrapper">
        <!-- <img src="/site_static/images/logo.svg" alt="Clyps"> -->

        <a href="/" class="logo-name">
          <h2 class="page-title">clyps<span class="text-primary">.</span>io</h2>
        </a>
        <div onclick="toggleMobileNav()" class="mobile-close"><i class="fa-solid fa-xmark"></i></div>
      </div>

      <div class="df links-wrapper ffp fs14">
        <div class="clip-row">
          <div class="icon-text" style="margin-bottom: 20px;">
            <p class="fs18 ffp" style="color: #db3965;">Just tell me what you<br>would like to post today.</p>
          </div>
        </div>
        <p class="example-text">Examples.<br /><br />"Write me a Happy New Year Post from a health insurance agency."<br /><br />"Give me a post congratulating Steve White on being the top broker of the month."<br /><br />"Create a motivational post."</p>
        <div class="clip-row clip-row-second">
          <div class="icon-text icon-area">
            <i class="fa-light fa-keyboard d-none"></i>
            <textarea class="article-textarea ai_field" name="clyps" placeholder="Enter your text here"></textarea>
          </div>
        </div>
      </div>

      <div class="df actions-wrapper ffp fs18">
        <div class="clip-column">
          <button class="clip-button clip-wide-button" onclick="generateClyps()">Generate</button>
          <p class="credits-left"><%= typeof generates_left != "undefined" ? generates_left === "Unlimited" ? generates_left + " credits" : generates_left + ' credits left' : undefined %></p>
          <p class="small-text">Generation costs = 1 credit</p>
        </div>
      </div>
      <script>
        function setSelectedPath() {
          $(`[data-path="${window.location.pathname}"]`).addClass("selected");
        }
        setSelectedPath();
      </script>
