            <div class="d-flex align-items-center">
                
                <% if(locals.accounts && locals.accounts.length){ %>
                    <select class="form-control mr-4" style="max-width: 300px;" onchange="location.href= '/login/' + this.value">
                        <option value="">Change Account</option>
                        <% locals.accounts.forEach(account => { %>
                            <option value="<%=account._id%>" <% if(account._id.toString() == user.account._id){ %> selected<% } %>><%=account.name%></option>
                        <% }) %>
                    </select>
    
                <% } %>
                
                <% if(show_export){ %>

                    <button class="btn btn-primary px-5 mr-3 badge-pill" onclick="editor.showExport()">Export</button>
    
                <% } %>
                
                <% if (locals.user){ %>
                    <div class="header-account">
                        <div class="account-profile">
                            <%= user.first_name ? user.first_name[0] : user.email[0] %>
                        </div>
                        <div class="account-menu rounded">
                            <div class="d-flex align-items-center pb-4 border-bottom pr-4">
                                <div class="account-profile mr-3">
                                    <%= user.first_name ? user.first_name[0] : user.email[0] %>
                                </div>
                                <div>
                                    <h5 class="mb-0"><%= user.first_name || 'No Name' %></h5>
                                    <div class="text-grey">
                                        <%= user.email %>
                                    </div>
                                </div>
                            </div>

                            <a href="/dashboard" class="d-flex text-grey my-3">
                                Dashboard
                            </a>

                            <a href="/projects" class="d-flex text-grey my-3">
                                Projects
                            </a>

                            <a href="/account" class="d-flex text-grey my-3">
                                Account
                            </a>

                            <a href="/onboarding"class="d-flex text-grey my-3">
                                Brand
                            </a>

                            

                            <a href="/logout" class="d-flex text-grey pt-3 border-top">
                                Logout
                            </a>
                        </div>
                    </div>
                <% } %>
            </div>
         </div>
     </div>
 </header>

 <script>
    function popupwindow(url, title, w, h) {
        var left = (screen.width/2)-(w/2);
        var top = (screen.height/2)-(h/2);
        return window.open(url, title, 'toolbar=no, location=no, directories=no, status=no, menubar=no, scrollbars=no, resizable=no, copyhistory=no, width='+w+', height='+h+', top='+top+', left='+left);
    } 
 </script>