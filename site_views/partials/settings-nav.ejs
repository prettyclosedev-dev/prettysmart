<link rel="stylesheet" href="/static/css/sub-nav.css?<%=Date.now()%>" />
<div class="sub-nav">
  <div class="df links-wrapper ffp fs18">
    <a
      class="df link-wrapper"
      href="/settings/account"
      data-path="/settings/account" onclick="navClicked()"
    >
      <span class="icon-text">Account info</span
      ><span class="icon-wrapper"><i class="fa-solid fa-info-circle"></i></span
    ></a>
    <a class="df link-wrapper" onclick="navClicked()" href="/settings/plan" data-path="/settings/plan">
      <span class="icon-text">Plans details</span
      ><span class="icon-wrapper"><i class="fa-solid fa-wallet"></i></span
    ></a>
    <a
      class="df link-wrapper"
      href="/settings/security"
      data-path="/settings/security" onclick="navClicked()"
    >
      <span class="icon-text">Security</span>
      <span class="icon-wrapper">
        <i class="fa-solid fa-shield-check"></i> </span
    ></a>
    <% if (user.master) { %>
      <a
        class="df link-wrapper"
        href="/settings/access"
        data-path="/settings/access" onclick="navClicked()"
      >
        <span class="icon-text">Access</span>
        <span class="icon-wrapper">
          <i class="fa-solid fa-users-gear"></i> </span
      ></a>
    <% } %>
  </div>
</div>

<script>
  function setSelectedPath() {
    // console.log("====");
    // console.log(window.location.pathname);
    // console.log("====");
    $(`[data-path="${window.location.pathname}"]`).addClass("selected");
  }
  setSelectedPath();

  function navClicked() {
    topbar.config({
      barThickness : 7,
      barColors    : {
        '0'        : '#db3965',
        '1.0'      : '#db3965'
        },
      })
          
      topbar.show()
    }
</script>
