<script>
    $(document).on('submit', '.signup-form', function() {
        var $form = $(this),
            data = $form.serializeArray();

            $form.find('.form-loader').addClass('d-flex');
        $.post($form.attr('action'), $.param(data), function(res){
            if (res && res.success) {
                window.location.href = "/onboarding"//"/settings/account";
            } else {
                alert(JSON.stringify(res))
            }
            $form.find('.form-loader').removeClass('d-flex');
        }).fail(function(res){
            console.log(res)
            if(res.responseJSON && res.responseJSON.errors){
                res.responseJSON.errors.forEach(function(error){
                    $('[data-field="'+ error.param +'"]').text(error.msg);
                })
            }else if(res.responseJSON && res.responseJSON.error){
                $('[data-field="signup"]').text(res.responseJSON.error.message);
            }else{                
                $('[data-field="signup"]').text(res.responseText);
            }
            $form.find('.form-loader').removeClass('d-flex');
        })

        return false;
    })
</script>
