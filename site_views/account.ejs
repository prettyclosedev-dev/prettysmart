<%- include('partials/header', {async: true}); %>

<div class="container account-page pb-5">
  <div class="border-top pt-5">
    <h1 class="text-primary mb-5">Account settings</h1>

    <div class="row justify-content-between">
      <div class="col-12 col-lg-3">
        <%- include('partials/account-menu', {async: true,tab:'account'}); %>
      </div>

      <div class="col-12 col-lg-8">
        <h2 class="text-grey">My Account</h2>

        <form action="/account" method="post">
          <div class="row">
            <div class="col">
              <div class="my-3">
                <div class="text-primary">Brand Name</div>
                <div class="fs22 font-weight-light">
                  <input
                    type="text"
                    name="name"
                    value="<%= user.account.name %>"
                    class="form-control"
                    required
                  />
                </div>
              </div>
              <div class="my-3">
                <div class="text-primary">Brand Email</div>
                <div class="fs22 font-weight-light">
                  <input
                    type="text"
                    name="brand_email"
                    value="<%= user.account.brand_email %>"
                    class="form-control"
                  />
                </div>
              </div>
              <div class="my-3">
                <div class="text-primary">Industry</div>
                <div class="fs22 font-weight-light">
                  <div class="input-group">
                    <input
                      type="text"
                      name="industry"
                      value="<%= user.account.industry %>"
                      class="form-control"
                      required
                    />
                  </div>
                </div>
              </div>
              <div class="my-3">
                <div class="text-primary">Describe your business</div>
                <div class="fs22 font-weight-light">
                  <div class="input-group">
                    <input
                      type="text"
                      name="industry_description"
                      value="<%= user.account.industry_description %>"
                      class="form-control"
                      required
                    />
                    <% if(user.master){ %>
                    <div class="input-group-append">
                      <a
                        href="/account/generate-ai"
                        class="input-group-text bg-white"
                      >
                        <svg
                          version="1.1"
                          xmlns="http://www.w3.org/2000/svg"
                          fill="#babece"
                          width="20"
                          height="20"
                          viewBox="0 0 512 512"
                          xmlns:xlink="http://www.w3.org/1999/xlink"
                          enable-background="new 0 0 512 512"
                        >
                          <g>
                            <g>
                              <path
                                d="m404.5,62.6l24.8-3.1c11.1-1.4 19-11.5 17.7-22.7-1.3-10.3-9.7-18.7-22.7-17.7l-74.6,9.3c-11.1,1.4-19,11.5-17.7,22.6l9.2,75.6c1.4,11.1 11.5,19.1 22.6,17.7 11.1-1.4 19.1-11.5 17.7-22.7l-3.4-28.1c70.1,52 99.2,142.2 72.3,225.7-26.9,83.5-105.9,140.8-193.2,141-12.9,0-21.1,8.6-21.4,19.8-0.2,11.2 7.8,20.8 21.4,20.8 104.8,0 199.7-68.9 231.9-169.2 32-99.1-2-206.4-84.6-269v-2.13163e-14z"
                              />
                              <path
                                d="m170.7,385.3c-1.4-11.1-11.5-19.1-22.6-17.7-11.1,1.4-19.1,11.5-17.7,22.7l3.4,28.1c-70.1-52-99.2-142.2-72.3-225.7 26.9-83.5 105.9-140.8 193.2-141 12.9,0 21.1-8.6 21.4-19.8 0.2-11.2-7.8-20.8-21.4-20.8-104.7-0.1-199.6,68.8-231.8,169.1-32,99.3 2,206.6 84.6,269.2l-24.8,3.1c-11.1,1.4-19,11.5-17.7,22.7 1.3,10.3 9.7,18.7 22.7,17.7l74.6-9.3c11.1-1.4 19-11.5 17.7-22.6l-9.3-75.7z"
                              />
                            </g>
                          </g>
                        </svg>
                      </a>
                    </div>
                    <% } %>
                  </div>
                </div>
              </div>
              <div class="my-3">
                <div class="text-primary">Brand Tagline</div>
                <div class="fs22 font-weight-light">
                  <div class="input-group">
                    <input
                      type="text"
                      name="tagline"
                      value="<%= user.account.tagline %>"
                      class="form-control"
                    />
                    <% if(user.master){ %>
                    <div class="input-group-append">
                      <a
                        href="/account/generate-tagline"
                        class="input-group-text bg-white"
                      >
                        <svg
                          version="1.1"
                          xmlns="http://www.w3.org/2000/svg"
                          fill="#babece"
                          width="20"
                          height="20"
                          viewBox="0 0 512 512"
                          xmlns:xlink="http://www.w3.org/1999/xlink"
                          enable-background="new 0 0 512 512"
                        >
                          <g>
                            <g>
                              <path
                                d="m404.5,62.6l24.8-3.1c11.1-1.4 19-11.5 17.7-22.7-1.3-10.3-9.7-18.7-22.7-17.7l-74.6,9.3c-11.1,1.4-19,11.5-17.7,22.6l9.2,75.6c1.4,11.1 11.5,19.1 22.6,17.7 11.1-1.4 19.1-11.5 17.7-22.7l-3.4-28.1c70.1,52 99.2,142.2 72.3,225.7-26.9,83.5-105.9,140.8-193.2,141-12.9,0-21.1,8.6-21.4,19.8-0.2,11.2 7.8,20.8 21.4,20.8 104.8,0 199.7-68.9 231.9-169.2 32-99.1-2-206.4-84.6-269v-2.13163e-14z"
                              />
                              <path
                                d="m170.7,385.3c-1.4-11.1-11.5-19.1-22.6-17.7-11.1,1.4-19.1,11.5-17.7,22.7l3.4,28.1c-70.1-52-99.2-142.2-72.3-225.7 26.9-83.5 105.9-140.8 193.2-141 12.9,0 21.1-8.6 21.4-19.8 0.2-11.2-7.8-20.8-21.4-20.8-104.7-0.1-199.6,68.8-231.8,169.1-32,99.3 2,206.6 84.6,269.2l-24.8,3.1c-11.1,1.4-19,11.5-17.7,22.7 1.3,10.3 9.7,18.7 22.7,17.7l74.6-9.3c11.1-1.4 19-11.5 17.7-22.6l-9.3-75.7z"
                              />
                            </g>
                          </g>
                        </svg>
                      </a>
                    </div>
                    <% } %>
                  </div>
                </div>
              </div>
              <div class="my-3">
                <div class="text-primary">Plan</div>
                <div class="fs22 font-weight-light">
                  $<%= plan.total %> / <%= plan.name %>
                </div>
              </div>
              <% if(user.master){ %>
              <div class="d-flex">
                <div class="my-3 mr-3">
                  <% if(user.account.isDraft){ %>
                  <a
                    href="/account/toggle-draft"
                    class="btn btn-sm btn-outline-primary px-4 badge-pill"
                    >Remove from draft</a
                  >
                  <% }else{ %>
                  <a
                    href="/account/toggle-draft"
                    class="btn btn-sm btn-outline-primary px-4 badge-pill"
                    >Add to draft</a
                  >
                  <% } %>
                </div>

                <div class="my-3">
                  <% if(user.account.isWaiting){ %>
                  <a
                    href="/account/toggle-waiting"
                    class="btn btn-sm btn-outline-primary px-4 badge-pill"
                    >Remove from waiting</a
                  >
                  <% }else{ %>
                  <a
                    href="/account/toggle-waiting"
                    class="btn btn-sm btn-outline-primary px-4 badge-pill"
                    >Add to waiting</a
                  >
                  <% } %>
                </div>
              </div>
              <% } %>
            </div>
          </div>

          <% if(user.master){ %>
          <div class="mb-4" style="max-height: 500px; overflow: auto">
            <% for(let key in user.account.AI){ %>
            <div class="mb-2 bg-light p-2">
              <div>
                <label for=""><%= key %></label>
                <input
                  type="text"
                  class="form-control form-control-sm"
                  name="AI[<%= key %>]"
                  value="<%= user.account.AI[key] %>"
                />
              </div>
            </div>
            <% } %>
          </div>
          <% } %>

          <button class="btn btn-primary badge-pill px-5">Save</button>
        </form>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer', {async: true}); %>
