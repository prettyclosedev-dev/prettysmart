<script>
  var user_location;

  $(document).ready(function () {
    $.ajax({
      url: "https://geolocation-db.com/jsonp",
      jsonpCallback: "callback",
      dataType: "jsonp",
      success: function (location) {
        user_location = location;
        // $('#country').html(location.country_name);
        // $('#state').html(location.state);
        // $('#city').html(location.city);
        // $('#latitude').html(location.latitude);
        // $('#longitude').html(location.longitude);
        // $('#ip').html(location.IPv4);
      },
    });
  });

  $(document).on("submit", ".signup-form", function () {
    var $form = $(this),
      data = $form.serializeArray();

    if (user_location) {
      const { country_name, state, city } = user_location;
      if (country_name || state || city) {
        data = [
          ...data,
          { name: "country", value: country_name },
          { name: "state", value: state },
          { name: "city", value: city },
        ];
      }
    }

    $form.find(".form-loader").addClass("d-flex");
    $.post($form.attr("action"), $.param(data), function (res) {
      $form.find(".form-loader").removeClass("d-flex");

      if (res.route) {
        if (typeof tap !== "undefined" && typeof tap.push === "function") {
          // Tapfiliate tracking for signups
          tap.push(["conversion", { conversion_type: "signup", amount: 0 }]);
        }

        // Redirect after tracking
        setTimeout(() => {
          window.location.href = res.route;
        }, 500); // Give some time for tracking to register
      } else if (res.error) {
        alert(JSON.stringify(res.error));
      } else {
        alert("Failed to signup!");
      }
    }).fail(function (res) {
      if (res.responseJSON && res.responseJSON.errors) {
        res.responseJSON.errors.forEach(function (error) {
          console.log(error)
          $('[data-field="' + error.path + '"]').text(error.msg);
        });
      } else if (res.responseJSON && res.responseJSON.error) {
        $('[data-field="signup"]').text(res.responseJSON.error.message);
      } else {
        $('[data-field="signup"]').text(res.error || res.responseText);
      }
      $form.find(".form-loader").removeClass("d-flex");
    });

    return false;
  });
</script>

<script>
    const field = (selector) => ({
        get value() {
            return $(selector).val();
        },
        set value(value) {
            $(selector).val(value);
        },
        get readonly() {
            return $(selector).attr("readonly");
        },
        set readonly(value) {
            $(selector).attr("readonly", value);
        },
    })
</script>

<script type="module">
  import { initializeApp } from "https://www.gstatic.com/firebasejs/9.17.2/firebase-app.js";
  import {
    getAuth,
    GoogleAuthProvider,
    signInWithPopup,
    signOut,
    getAdditionalUserInfo,
    onAuthStateChanged
  } from "https://www.gstatic.com/firebasejs/9.17.2/firebase-auth.js";

  // injected by Express
  const firebaseConfig = JSON.parse('<%- JSON.stringify(firebaseConfig ?? {}) %>');
  const googleInfo = JSON.parse('<%- JSON.stringify(googleInfo ?? {}) %>');

  const app = initializeApp(firebaseConfig);
  const auth = getAuth(app);
  const provider = new GoogleAuthProvider();

  let firstName = googleInfo.firstName
  let lastName = googleInfo.lastName

  
  const onStep1 = () => {
    $(".step-1").each(function() {
        $(this).removeClass("d-none");
    });
    $(".step-2").each(function() {
        $(this).addClass("d-none");
    });
  }

  const prev = () => {
    $(".step-2").each(function() {
        $(this).addClass("d-none");
    });
    $(".step-1").each(function() {
        $(this).removeClass("d-none");
    });
  }

  const next = () => {
    $(".step-1").each(function() {
        $(this).addClass("d-none");
    });
    $(".step-2").each(function() {
        $(this).removeClass("d-none");
    });
  }


  const signIn = async () => {
    try {
        const result = await signInWithPopup(auth, provider);
        const info = getAdditionalUserInfo(result);

        if (info && info.profile) {
            // these fields come directly from Google’s OAuth response
            firstName  = info.profile.given_name;
            lastName   = info.profile.family_name;
        }

        $("input[name='googleuid']").val(result.user.uid);
        $("input[name='email']").val(result.user.email);
        $("input[name='email']").attr("readonly", "readonly");
        $("input[name='first_name']").val(firstName ?? result.user.displayName.split(' ')[0]);
        $("input[name='first_name']").attr("readonly", "readonly");
        $("input[name='last_name']").val(lastName ?? result.user.displayName.split(' ').slice(1).join(' '));
        $("input[name='last_name']").attr("readonly", "readonly");
        $(".google-logged-in").removeClass("d-none");
        $(".google-logged-out").addClass("d-none");
        
        $(".signup-form").submit();

        next(); 

        $("#password-row").addClass("d-none");
        $("input[name='password']").removeAttr("required");
        $("input[name='confirm_password']").removeAttr("required");

    } catch (err) {
      console.error('Auth error', err);
    }
  };

  onAuthStateChanged(auth, (user) => {

    if (user && user.uid === googleInfo.googleuid) {
        console.log({ user, googleInfo });
        $(".google-logged-in").removeClass("d-none");
        $(".google-logged-out").addClass("d-none");
        $("input[name='googleuid']").val(user.uid);
        $("input[name='email']").val(user.email);
        $("input[name='email']").attr("readonly", "readonly");
        $("input[name='first_name']").val(firstName ?? user.displayName.split(' ')[0]);
        $("input[name='first_name']").attr("readonly", "readonly");
        $("input[name='last_name']").val(lastName ?? user.displayName.split(' ').slice(1).join(' '));
        $("input[name='last_name']").attr("readonly", "readonly");
        
        next();

        $("#password-row").addClass("d-none");
        $("input[name='password']").removeAttr("required");
        $("input[name='confirm_password']").removeAttr("required");
    } else {
        $(".google-logged-in").addClass("d-none");
        $(".google-logged-out").removeClass("d-none");
        $("input[name='googleuid']").val("");
        $("input[name='email']").val("");
        $("input[name='email']").removeAttr("readonly");
        $("input[name='first_name']").val("");
        $("input[name='first_name']").removeAttr("readonly");
        $("input[name='last_name']").val("");
        $("input[name='last_name']").removeAttr("readonly");
        $("input[name='phone']").val("");
        $("input[name='phone']").removeAttr("readonly");
        $("#password-row").removeClass("d-none");
        $("input[name='password']").attr("required");
        $("input[name='confirm_password']").attr("required");
        prev();
    }

    $(".text-danger").each(function() {
        $(this).text("");
    })
  });

  $("#google-signin").on("click", signIn);

  $("#google-signout").on("click", () => signOut(auth))

  $("#next").on("click", () => {
      next();
  })
</script>
