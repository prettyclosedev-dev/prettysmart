<%- include('partials/header', {async: true}); %>

<div class="container account-page pb-5">
    <div class="border-top pt-5">

        <h1 class="text-primary mb-5">
            Account settings
        </h1>

        <div class="row justify-content-between">
            <div class="col-12 col-lg-3">
                <%- include('partials/account-menu', {async: true,tab:'users'}); %>
            </div>

            <div class="col-12 col-lg-8">
                <h2 class="text-grey">
                    Users
                </h2>

                <div class="mt-3 account-users">
                    <% users.forEach(usr => { %>

                        <div class="border-top py-3">
                            <div class="row align-items-center">
                                <div class="col-1">
                                    <a href="/account/users/<%=usr._id%>" class="account-profile mr-3">
                                        <%= usr.name[0] %>
                                    </a>
                                </div>
                                <div class="col-6 pl-lg-0">
                                    <a href="/account/users/<%=usr._id%>" class="text-dark"><%= usr.first_name %> <%= usr.last_name %></a>
                                    <br>
                                    <a href="/account/users/<%=usr._id%>" class="text-dark font-weight-light">
                                        <%= usr.email %>
                                    </a>
                                </div>
                                <div class="col text-right">
                                    <% if(users.length > 1 && usr._id.toString() !== locals.user._id.toString()){ %>
                                        <a href="/account/users/<%=usr._id%>/delete" class="badge-danger badge-pill py-2 px-3 text-uppercase">
                                            Delete
                                        </a>
                                    <% } %>

                                    <!-- <span class="badge-secondary badge-pill py-2 px-3 ml-3 text-uppercase">
                                        <%= user.role || 'User' %>
                                    </span> -->
                                </div>
                            </div>
                        </div>

                    <% }) %>

                    <div class="border-top py-3">
                        <div class="row align-items-center">
                            
                            <div class="col text-right">
                                <a href="/account/users/new" class="btn btn-outline-primary btn-sm badge-pill px-3">
                                    Add User
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('partials/footer', {async: true}); %>