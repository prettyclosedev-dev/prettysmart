<script src="/static/js/jquery.fontpicker.js?<%=Date.now()%>"></script>

<script>

    function setupForms(options){
        $('[name="email"]').val('<%=user.email%>')
        
        $('.hs-button:not(.btn)').addClass('btn btn-secondary px-5 badge-pill').attr('type', 'button')

        if(options.back){
            $('.actions:not(.added)').prepend('<div class="section-back">Back</div>').addClass('added')
        }else{
            $('.actions:not(.added)').prepend('<div></div>').addClass('added')
        }

        var $primary_color = $('[name="primary_color"]'),
            $secondary_color = $('[name="secondary_color"]');
        $primary_color.attr('type', 'color').parent().addClass('color-picker').css('background-color', $primary_color.val())
        $secondary_color.attr('type', 'color').parent().addClass('color-picker').css('background-color', $secondary_color.val())
    }
    
    $(document).on('change', '[type="file"]', function(e){
        var $this = $(this),
            copy = $('<input type="file" multiple/>'),
            uniq_id = $this.index();

        copy.attr('name', $this.attr('name'))
        $this.after(copy);
        $this.addClass('has-files');

        if(!$this.closest('.brand-section').find('.hs-files').length){
            $this.closest('.brand-section').find('.hs_google_font, .hs-logos').after('<div class="hs-files"></div>');
        }
        
        for (var i = 0; i < e.target.files.length; i++){
            if(e.target.files[i].name){
                $this.closest('.brand-section').find('.hs-files').append('<div class="hs-file-preview" data-input="'+uniq_id +'"><div class="hs-file-preview-name">'+e.target.files[i].name+'</div><div class="hs-file-preview-remove"></div></div>')
            }
        }
    }).on('click', '.hs-file-preview-remove', function(){
        var uniq_id = $(this).parent().data('input');
        
        $(this).closest('.brand-section').find('[type="file"]').eq(uniq_id).val('');
        $('[data-input="'+uniq_id +'"]').remove();

    }).on('change keyup input', '[type="color"]', function(){
        $(this).parent().css('background-color', $(this).val())
    }).on('click', '.hs-button', function(){

        var section = $(this).closest('.brand-section');

        if(section.next('.brand-section').length){
            section.hide();
            section.next('.brand-section').fadeIn();
        }else{
            //Subbmit
            $('.brand-loader').addClass('d-flex');
            
            var logo_files = $('.logos-section').find('[type="file"]').filter(function(){
                return $(this).val()
            });
            if(logo_files.length){
                $('.logos-section form').submit();
            }else{
                var fonts_files = $('.fonts-section').find('[type="file"]').filter(function(){
                    return $(this).val()
                });
                if(fonts_files.length){
                    $('.font-section form').submit();
                }else{
                    $('.colors-section form').submit();
                }
            }
        }

    }).on('click', '.section-back', function(){

        var section = $(this).closest('.brand-section');

        section.hide();
        section.prev('.brand-section').fadeIn();

    })
</script>