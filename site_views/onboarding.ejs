<script>
    
    var draft_brand = '<%- JSON.stringify(brand) %>';

    function getFiles(e) {
        let $container = $("#selected-files-list")
        
        $container.empty()

        Array.from(e.target.files).map(file=> {
            $container.append(`<p>${file.name}</p>`)
        })
        $(".file-list").append('<span class="fa-stack"><i style="color:#EBB221;" class="fas fa-circle fa-stack-2x"></i><i class="fas fa-info fa-xs fa-stack-1x fa-inverse"></i></span>')
    }

    $(document).ready(() => {
        // $("#upload-logo-label").hover(() => {
        //     $("#logo-preview").toggleClass("lower-opacity")
        //     $("#select-prompt").toggleClass("d-none")
        // })

        $("#upload-logo-label")
            .on("mouseenter", () => {
                if($(".logo-container").attr("hidden") !== undefined) return

                $("#logo-preview").addClass("lower-opacity")
                $("#select-prompt").removeClass("d-none")
            }).on("mouseleave", () => {
                if($(".logo-container").attr("hidden") !== undefined) return

                $("#logo-preview").removeClass("lower-opacity")
                $("#select-prompt").addClass("d-none")
            })
    })
</script>

