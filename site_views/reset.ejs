<%- include('partials/header', {async: true,fixed_header:true}); %>
<div class="login-page d-flex align-items-center justify-content-center">
    <div>
        <div class="login-title">
            <h1 class="text-center">
                Reset Password
            </h1>
            <p class="text-center fs18">
                Don't have an account?  <a href="/signup">Sign Up</a>
            </p>
        </div>

        
        <form action="/reset/<%=token%>" method="post" class="mx-auto login-form position-relative">
            <div class="text-danger text-center" data-field="reset"></div>  
            <div class="mb-4">
                <div class="input-group input-group-lg">
                    <div class="input-group-prepend">
                      <span class="input-group-text bg-white px-3">
                        <svg xmlns="http://www.w3.org/2000/svg" width="13.806" height="17.609" viewBox="0 0 13.806 17.609"><g transform="translate(0 0)"><path d="M12.506,7.234V5.6A5.6,5.6,0,0,0,1.3,5.6V7.234A1.6,1.6,0,0,0,0,8.8v7.2a1.6,1.6,0,0,0,1.6,1.6H12.206a1.6,1.6,0,0,0,1.6-1.6V8.8A1.6,1.6,0,0,0,12.506,7.234Zm-5,5.6v2.37H6.3v-2.37a1.6,1.6,0,1,1,1.2,0ZM10.1,7.2H3.7V5.6a3.2,3.2,0,1,1,6.4,0Z" transform="translate(0 0)" fill="#b6bacb"/></g></svg>
                      </span>
                    </div>
                    <input type="password" name="password" placeholder="New Password" class="form-control">
                </div>
                <div class="text-danger" data-field="password"></div>
            </div>
            <div class="mb-4">
                <div class="input-group input-group-lg">
                    <div class="input-group-prepend">
                      <span class="input-group-text bg-white px-3">
                        <svg xmlns="http://www.w3.org/2000/svg" width="13.806" height="17.609" viewBox="0 0 13.806 17.609"><g transform="translate(0 0)"><path d="M12.506,7.234V5.6A5.6,5.6,0,0,0,1.3,5.6V7.234A1.6,1.6,0,0,0,0,8.8v7.2a1.6,1.6,0,0,0,1.6,1.6H12.206a1.6,1.6,0,0,0,1.6-1.6V8.8A1.6,1.6,0,0,0,12.506,7.234Zm-5,5.6v2.37H6.3v-2.37a1.6,1.6,0,1,1,1.2,0ZM10.1,7.2H3.7V5.6a3.2,3.2,0,1,1,6.4,0Z" transform="translate(0 0)" fill="#b6bacb"/></g></svg>
                      </span>
                    </div>
                    <input type="password" name="confirm_password" placeholder="Confirm Password" class="form-control">
                </div>
                <div class="text-danger" data-field="confirm_password"></div>
            </div>
            <div>
                <input type="submit" value="Reset" class="btn btn-block btn-primary">
            </div>
            <div class="form-loader">
                <svg version="1.1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" x="0px" y="0px"
                    viewBox="0 0 100 100" enable-background="new 0 0 100 100" xml:space="preserve">
                    <rect fill="none" stroke="#F7176D" stroke-width="4" x="25" y="25" width="50" height="50">
                        <animateTransform attributeName="transform" dur="0.5s" from="0 50 50" to="180 50 50" type="rotate"
                            id="strokeBox" attributeType="XML" begin="rectBox.end" />
                    </rect>
                    <rect x="27" y="27" fill="#F7176D" width="46" height="50">
                        <animate attributeName="height" dur="1.3s" attributeType="XML" from="50" to="0" id="rectBox"
                            fill="freeze" begin="0s;strokeBox.end" />
                    </rect>
                </svg>
            </div>
        </form>

        
    </div>
</div>        
<%- include('partials/footer', {async: true}); %>

<script>
    $(document).on('submit', '.login-form', function(){
        var $form = $(this),
            data = $form.serialize();

        $form.find('.form-loader').addClass('d-flex');
        $('[data-field="reset"]').text("");
        $('[data-field="password"]').text("");
        $('[data-field="confirm_password"]').text("");

        $.post($form.attr('action'), data, function(res) {
            if (!res.success) {
                failed(res, $form)
            } else {
                window.location.href = res.href;
            }
        }).fail(function(res){
            failed(res, $form)
        })

        return false;
    })

    function failed(res, $form) {
        if (res.errors) {
            res.errors.forEach(function(error){
                $('[data-field="'+ error.param +'"]').text(error.msg);
            })
        } else if (res.error){
            $('[data-field="reset"]').text(res.error.message);
        } else if (res.text) {                
            $('[data-field="reset"]').text(res.text);
        }
        $form.find('.form-loader').removeClass('d-flex');
    }
</script>
