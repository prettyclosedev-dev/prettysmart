<%- include('partials/header', {async: true}); %>
<link rel="stylesheet" href="/static/css/plans.css?<%=Date.now()%>">

<!-- Welcome Modal -->
<div id="welcome-modal" class="welcome-modal">
  <div class="welcome-modal-content">
    <span class="close-modal">&times;</span>
    <div class="modal-text">
      <h1>Welcome!</h1>
      <p>
        Discover the features designed to make your experience smooth and enjoyable. Start exploring and make the most out of your plans.
      </p>
      <a href="#plans-seg" class="btn-primary">Get Started</a>
    </div>
  </div>
</div>

<div class="df page-wrapper df ffp">
  <div class="page-content">

    <div class="plans-page go-pro-page" style="padding: 32px;">
      <div class="page-content-wrapper">
        <div class="page-title-container d-flex justify-content-center mb-5">
          <a href='<%= affiliate ? "/landing?affiliate=true" : "/landing" %>'>
            <img id="logo-img" src="/site_static/images/logo.svg" alt="Prettyclose" class="object-contain" style="object-fit: cover; width: 20vw;" />
          </a>
        </div>
        <div class="df inner-content-wrapper">
          <div class="plans-wrapper">
            <script>
              $(document).on('click', "#plan-button", function(e) {

              });
            </script>
            <script>
              $(document).on('change', '[type="radio"]', function(e) {
                var new_interval = $(this).attr("id").includes("month") ? 'month' : 'year'
                $.post(`/subscribe/interval/${new_interval}`, function(data) {
                  $('.price-items').html($(data).find('.price-items').html());
                });
              });
              </script>
            <div class="seg-wrapper" style="display: flex; align-self: center;">
              <%- include('partials/segment-control', {async: true, options: [{value: "Monthly", id: "month", selected: interval === "month"}, {value: "Yearly 20% off", id: "year", selected: interval === "year"}], inverted: true, segmentID: "plans-seg"}); %>
            </div>
            <%- include('partials/plans-items', {async: true, onGray: true, products: products.data, interval, current: subscription && subscription.plan ? subscription.plan.id : null}); %>
          </div>
        </div>
      </div>

      <% if (typeof error != "undefined") { %>
        <div>An error occurred: <%= error %></div>
      <% } %>

      <%- include('partials/footer', {async: true, authenticated: false}); %>

    </div>

  </div>
</div>

<!-- Welcome Modal Script -->
<script>
  $(document).ready(function() {
    const $modal = $('#welcome-modal');

    // Show modal with animation
    $modal.addClass('show');

    // Close modal when × is clicked
    $modal.find('.close-modal').on('click', function() {
      $modal.removeClass('show');
    });

    // Close when clicking outside the content
    $modal.on('click', function(e) {
      if ($(e.target).is($modal)) {
        $modal.removeClass('show');
      }
    });

    $modal.find('.btn-primary').on('click', function() {
      $modal.removeClass('show');
    });
  });
</script>

</body>

</html>