    <section class="banner">
        <div class="container">
            <div class="content">
                <div class="text-main">
                    <h1 class="wowo fadeInUp delay-in-1">Branded Design fast.</h1>
                    <div class="wowo fadeInUp delay-in-2"><p class="pb-lg-5">Enter your text and the app will create a design according to your brand, in literally seconds.</p></div>
                 
                    <form action="" class="wowo fadeInUp delay-in-3">
                        <div class="email">
