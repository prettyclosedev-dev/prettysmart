<script>
    const app = Vue.createApp({
        data() {
            return {
                svgTree: {},
                original_file: '',
                original_svg: '',
                modified_svg: '',
                selectedElements: [],
                floatingElements: [],
                is_in_click:true,
            }
        },
        methods: {

            init(){
                // Always use the main logo as the source for selection.
                // If no logo exists, fall back to the current target (icon/wordmark) so the editor still opens.
                const type = $("#svg-editor-popup-wrpr").attr("data-type");
                let source = $("#logo-preview svg")[0];
                if (!source) {
                    if (type === 'icon') {
                        source = $("#icon-preview svg")[0];
                    } else if (type === 'wordmark') {
                        source = $("#wordmark-preview svg")[0];
                    }
                }
                this.original_svg = source?.outerHTML || '';
                if (!this.original_svg) {
                    try { alert('Please upload your Logo first to select from it.'); } catch(_) {}
                }
            //call API
            //Setup game
            },

            // ***************
            fileUploaded: function (e) {
                var file2 =  $("#svg-editor-popup-wrpr svg")[0];
                var file = e.target.files[0];
                const reader = new FileReader();

                reader.addEventListener("load", () => {
                    // this will then display a text file
                    var text = reader.result;
                    this.original_svg = text;
                    var el = file2;
                }, false);

                if (file) {
                    reader.readAsText(file);
                }
            },
            // ******************
            // fileUploaded: function (e) {
            //     var file = $("#svg-editor-popup svg")[0];
            //     // const reader = new FileReader();

            //     reader.addEventListener("load", () => {
            //         // this will then display a text file
            //         var text = reader.result;
            //         this.original_svg = text;
            //         var el = document.getElementsByTagName("svg");
            //     }, false);

            //     if (file) {
            //         reader.readAsText(file);
            //     }
            // },
            generate_svg: function () {
               
                var svg = document.createElementNS("http://www.w3.org/2000/svg", "svg");
                svg.setAttribute("version", "1.1");
                svg.setAttribute("xmlns", "http://www.w3.org/2000/svg");
                svg.setAttribute("xmlns:xlink", "http://www.w3.org/1999/xlink");
                var heights = [];
                var widths = [];
                var xs = [];
                var ys = [];

                if (!this.selectedElements || !this.selectedElements.length) {
                    alert("Please select elements.")
                    return;
                }

                this.selectedElements.forEach(path => {
                    heights.push(path.getBBox().height);
                    widths.push(path.getBBox().width);
                    xs.push(path.getBBox().x);
                    ys.push(path.getBBox().y);
                    svg.appendChild(path.cloneNode(true));
                });
                var x = Math.min(...xs);
                var y = Math.min(...ys);
                var width = Math.max(...widths.map((w, i) => w = w + xs[i] - x));
                var height = Math.max(...heights.map((h, i) => h = h + ys[i] - y));

                const arr = [x, y, width, height];
                const match = arr.find(element => {
                    if (typeof element === "string" && element.indexOf('Infinity') > -1) {
                        return true;
                    }
                });

                if (match !== undefined) {
                    alert("Could not generate svg, no paths found.")
                    return;
                }

                svg.setAttribute("viewBox", `${x} ${y} ${width} ${height}`);

                var alldefs = document.getElementById("original-container").getElementsByTagName("defs");
                if (alldefs.length > 0) {
                    var defs = alldefs[0];
                    svg.insertBefore(defs.cloneNode(true), svg.firstChild);
                }

                var svg_string = new XMLSerializer().serializeToString(svg);
                const type = $("#svg-editor-popup-wrpr").attr("data-type");

                // $(".dummy-select-or-edit .logo-select-wrapper").find("p span").text(type);
                // console.log($(".dummy-select-or-edit .logo-select-wrapper").find(".upload-wrapper").attr("onclick"))
                // $(".dummy-select-or-edit .logo-select-wrapper").find(".upload-wrapper").attr("onclick", openSVGEditor(event, type));
                // $selectOrEdit = $(".dummy-select-or-edit .logo-select-wrapper").prop("outerHTML");
                // var text = ".onboarding-logo-preview#" + type + "-preview"
                // console.log(text, $(".onboarding-logo-preview#" + type + "-preview"))
                // $selectOrEdit = $(".onboarding-logo-preview#" + type + "-preview").prop("outerHTML");

                if (!svg_string.includes("Infinity")) { // empty
                    var innerHtml = $("#"+type+"-preview")[0].innerHTML;
                    var regex = new RegExp(`<svg.*?</svg>`, "g");
                    innerHtml = innerHtml.replace(regex, ``);

                    $("#"+type+"-preview")[0].innerHTML = svg_string + innerHtml;
                    $("#"+type+"-preview").siblings("input").addClass("touched svg-string");
                    $("#"+type+"-preview").find(".logo-select-wrapper").addClass("floating");

                    $("#svg-editor-popup-wrpr").addClass("d-none");

                    // $("#"+type+"-preview").siblings('[type="file"]').addClass("touched");
                    uploadLogo($("#"+type+"-preview").closest(".onboarding-logo-inner"), true);
                    addTabState("logo", "draft");
                }

                // updateLogos();
               
                // var svg_blob = new Blob([svg_string], {
                //     type: "image/svg+xml;charset=utf-8"
                // });
                // var svg_url = URL.createObjectURL(svg_blob);
                // var downloadLink = document.createElement("a");
                // downloadLink.href = svg_url;
                // downloadLink.download = "svg.svg";
                // console.log(downloadLink)
                // document.body.appendChild(downloadLink);
                // downloadLink.click();
                // document.body.removeChild(downloadLink);
                // this.selectedElements = [];
                // console.log(this.selectedElements);
            }
        },

        updated() {
            var self = this;
           
            try {
                this.original_svg = this.$refs.container.innerHTML;

                window.svgDragSelectOptions = {
                    svg: $("#svg-editor-popup-wrpr svg")[0],
                    onSelectionStart: function (selectionStart) {
                        const selectedElements = selectionStart.svg.querySelectorAll('[data-selected]')
                        for (let i = 0; i < selectedElements.length; i++) {
                            selectedElements[i].removeAttribute('data-selected')
                        }
                        self.floatingElements = [];

                        // Clear selection overlay
                        const svg = selectionStart.svg;
                        let overlay = svg.querySelector('#selection-overlay');
                        if (overlay) overlay.innerHTML = '';
                    },
                    onSelectionEnd: function (selectionEnd) {
                        if (selectionEnd.dragAreaInClientCoordinate.height<5 && selectionEnd.dragAreaInClientCoordinate.width<5) {
                            var current_element = selectionEnd.selectedElements[0]; // TODO: - handle current_element null
                            var current=self.selectedElements.indexOf(current_element) !== -1;
                            if (current) {
                                current_element.removeAttribute('data-selected');
                                var position = self.selectedElements.indexOf(current_element);
                                self.selectedElements[position] = self.selectedElements[ self.selectedElements.length - 1 ];
                                self.selectedElements.pop();
                            } else {
                                current_element.setAttribute('data-selected', 'true');
                                self.selectedElements.push(current_element);
                            }
                            self.selectedElements.forEach(path => {
                                path.setAttribute('data-selected', 'true');
                            });
                        } else {
                            self.selectedElements = [];
                            selectionEnd.selectedElements.forEach(element => {
                                element.setAttribute('data-selected', 'true');
                                self.selectedElements.push(element);
                            });
                        }

                        // Draw/update selection frame
                        drawSelectionFrame(selectionEnd.svg, self.selectedElements);
                    },
                    onSelectionChange: function (selectionChange) {
                        selectionChange.newlyDeselectedElements.forEach(function (element) {
                            element.removeAttribute('data-selected')
                        })
                        selectionChange.newlySelectedElements.forEach(function (element) {
                            element.setAttribute('data-selected', '')
                        })
                        selectionChange.newlySelectedElements.forEach(element => {
                        
                        });

                        // Live-update selection frame as the selection changes
                        const svg = $("#svg-editor-popup-wrpr svg")[0];
                        drawSelectionFrame(svg, self.selectedElements);
                    },
                    selector: "intersection",
                }

                svgDragSelect(svgDragSelectOptions)

                // Helpers to render a nice-looking selection frame
                function ensureOverlay(svg) {
                    // Ensure defs with a subtle drop shadow
                    let defs = svg.querySelector('defs');
                    if (!defs) {
                        defs = document.createElementNS('http://www.w3.org/2000/svg', 'defs');
                        svg.insertBefore(defs, svg.firstChild);
                    }
                    let shadow = svg.querySelector('#ps-selection-shadow');
                    if (!shadow) {
                        shadow = document.createElementNS('http://www.w3.org/2000/svg', 'filter');
                        shadow.setAttribute('id', 'ps-selection-shadow');
                        shadow.setAttribute('x', '-20%');
                        shadow.setAttribute('y', '-20%');
                        shadow.setAttribute('width', '140%');
                        shadow.setAttribute('height', '140%');
                        const feDrop = document.createElementNS('http://www.w3.org/2000/svg', 'feDropShadow');
                        feDrop.setAttribute('dx', '0');
                        feDrop.setAttribute('dy', '1');
                        feDrop.setAttribute('stdDeviation', '1.2');
                        feDrop.setAttribute('flood-color', '#000000');
                        feDrop.setAttribute('flood-opacity', '0.25');
                        shadow.appendChild(feDrop);
                        defs.appendChild(shadow);
                    }

                    // Ensure CSS keyframes for dashed animation (works with px units)
                    let animStyle = svg.querySelector('#ps-selection-anim-style');
                    if (!animStyle) {
                        animStyle = document.createElementNS('http://www.w3.org/2000/svg', 'style');
                        animStyle.setAttribute('id', 'ps-selection-anim-style');
                        animStyle.textContent = `
                            @keyframes psDash { to { stroke-dashoffset: 30px; } }
                        `;
                        defs.appendChild(animStyle);
                    }

                    // Ensure overlay group
                    let overlay = svg.querySelector('#selection-overlay');
                    if (!overlay) {
                        overlay = document.createElementNS('http://www.w3.org/2000/svg', 'g');
                        overlay.setAttribute('id', 'selection-overlay');
                        overlay.setAttribute('pointer-events', 'none');
                        svg.appendChild(overlay);
                    }
                    return overlay;
                }

                function drawSelectionFrame(svg, elements) {
                    const overlay = ensureOverlay(svg);
                    overlay.innerHTML = '';
                    if (!elements || !elements.length) return;

                    const bbox = getUnionBBoxInRoot(svg, elements);
                    if (!bbox) return;
                    // Apply visual padding around selection (fixed px converted to user units)
                    let x = bbox.x, y = bbox.y, width = bbox.width, height = bbox.height;
                    try {
                        const m = svg.getScreenCTM();
                        const sx = Math.hypot(m.a, m.c);
                        const sy = Math.hypot(m.b, m.d);
                        const s = (sx + sy) / 2 || 1;
                        const padPx = 5; // desired padding in pixels
                        const padUser = padPx / s;
                        x -= padUser; y -= padUser; width += padUser * 2; height += padUser * 2;
                        width = Math.max(0, width); height = Math.max(0, height);
                    } catch(_) {}

                    // Soft highlight inside the selection
                    const fillRect = document.createElementNS('http://www.w3.org/2000/svg', 'rect');
                    fillRect.setAttribute('x', x);
                    fillRect.setAttribute('y', y);
                    fillRect.setAttribute('width', width);
                    fillRect.setAttribute('height', height);
                    fillRect.setAttribute('rx', 10);
                    fillRect.setAttribute('ry', 10);
                    fillRect.setAttribute('fill', '#db3965');
                    fillRect.setAttribute('fill-opacity', '0.10');
                    overlay.appendChild(fillRect);

                    // White halo behind the main stroke for contrast on busy backgrounds
                    const halo = document.createElementNS('http://www.w3.org/2000/svg', 'rect');
                    halo.setAttribute('x', x);
                    halo.setAttribute('y', y);
                    halo.setAttribute('width', width);
                    halo.setAttribute('height', height);
                    halo.setAttribute('rx', 10);
                    halo.setAttribute('ry', 10);
                    halo.setAttribute('fill', 'none');
                    halo.setAttribute('stroke', '#FFFFFF');
                    halo.setAttribute('stroke-width', '10');
                    halo.style.strokeWidth = '5px';
                    halo.setAttribute('stroke-linejoin', 'round');
                    halo.setAttribute('vector-effect', 'non-scaling-stroke');
                    halo.setAttribute('opacity', '0.95');
                    halo.setAttribute('filter', 'url(#ps-selection-shadow)');
                    overlay.appendChild(halo);

                    // Main dashed stroke (no animation) with fixed visual thickness/length
                    const rect = document.createElementNS('http://www.w3.org/2000/svg', 'rect');
                    rect.setAttribute('x', x);
                    rect.setAttribute('y', y);
                    rect.setAttribute('width', width);
                    rect.setAttribute('height', height);
                    rect.setAttribute('rx', 10);
                    rect.setAttribute('ry', 10);
                    rect.setAttribute('fill', 'none');
                    rect.setAttribute('stroke', '#672a41');
                    rect.setAttribute('vector-effect', 'non-scaling-stroke');
                    // Use CSS px units so thickness and dash length are fixed regardless of SVG scaling
                    rect.style.strokeWidth = '3px';
                    rect.style.strokeDasharray = '20px 10px';
                    rect.style.strokeDashoffset = '0px';
                    rect.style.animation = 'psDash 1.2s linear infinite';
                    rect.setAttribute('stroke-linecap', 'round');
                    rect.setAttribute('filter', 'url(#ps-selection-shadow)');
                    overlay.appendChild(rect);

                    // Removed corner handles (circles) for a cleaner selection frame
                }

                function getUnionBBoxInRoot(svg, elements) {
                    try {
                        const rootCTM = svg.getScreenCTM();
                        if (!rootCTM) return null;
                        const invRoot = rootCTM.inverse();
                        const toRoot = (pt, mat) => pt.matrixTransform(mat).matrixTransform(invRoot);

                        let minX = Infinity, minY = Infinity, maxX = -Infinity, maxY = -Infinity;
                        for (const el of elements) {
                            const b = el.getBBox();
                            const m = el.getScreenCTM();
                            if (!b || !m) continue;

                            const p1 = svg.createSVGPoint(); p1.x = b.x;           p1.y = b.y;
                            const p2 = svg.createSVGPoint(); p2.x = b.x + b.width; p2.y = b.y;
                            const p3 = svg.createSVGPoint(); p3.x = b.x;           p3.y = b.y + b.height;
                            const p4 = svg.createSVGPoint(); p4.x = b.x + b.width; p4.y = b.y + b.height;

                            const r1 = toRoot(p1, m); const r2 = toRoot(p2, m);
                            const r3 = toRoot(p3, m); const r4 = toRoot(p4, m);

                            minX = Math.min(minX, r1.x, r2.x, r3.x, r4.x);
                            minY = Math.min(minY, r1.y, r2.y, r3.y, r4.y);
                            maxX = Math.max(maxX, r1.x, r2.x, r3.x, r4.x);
                            maxY = Math.max(maxY, r1.y, r2.y, r3.y, r4.y);
                        }

                        if (!isFinite(minX) || !isFinite(minY) || !isFinite(maxX) || !isFinite(maxY)) return null;
                        return { x: minX, y: minY, width: Math.max(0, maxX - minX), height: Math.max(0, maxY - minY) };
                    } catch (_) {
                        return null;
                    }
                }

            }
            catch (e) {
                console.log(e);
            }
        },

        mounted(){
            this.init()
        }

    }).mount('#svg-editor-app');

    window.app = app;

