            generate_svg: function () {
               
                var svg = document.createElementNS("http://www.w3.org/2000/svg", "svg");
                svg.setAttribute("version", "1.1");
                svg.setAttribute("xmlns", "http://www.w3.org/2000/svg");
                svg.setAttribute("xmlns:xlink", "http://www.w3.org/1999/xlink");
                var heights = [];
                var widths = [];
                var xs = [];
                var ys = [];

                if (!this.selectedElements || !this.selectedElements.length) {
                    alert("Please select elements.")
                    return;
                }

                this.selectedElements.forEach(path => {
                    heights.push(path.getBBox().height);
                    widths.push(path.getBBox().width);
                    xs.push(path.getBBox().x);
                    ys.push(path.getBBox().y);
                    svg.appendChild(path.cloneNode(true));
                });
                var x = Math.min(...xs);
                var y = Math.min(...ys);
                var width = Math.max(...widths.map((w, i) => w = w + xs[i] - x));
                var height = Math.max(...heights.map((h, i) => h = h + ys[i] - y));

                const arr = [x, y, width, height];
                const match = arr.find(element => {
                    if (typeof element === "string" && element.indexOf('Infinity') > -1) {
                        return true;
                    }
                });

                if (match !== undefined) {
                    alert("Could not generate svg, no paths found.")
                    return;
                }

                svg.setAttribute("viewBox", `${x} ${y} ${width} ${height}`);

                var alldefs = document.getElementById("original-container").getElementsByTagName("defs");
                if (alldefs.length > 0) {
                    var defs = alldefs[0];
                    svg.insertBefore(defs.cloneNode(true), svg.firstChild);
                }

                var svg_string = new XMLSerializer().serializeToString(svg);
                const type = $("#svg-editor-popup-wrpr").attr("data-type");

                // $(".dummy-select-or-edit .logo-select-wrapper").find("p span").text(type);
                // console.log($(".dummy-select-or-edit .logo-select-wrapper").find(".upload-wrapper").attr("onclick"))
                // $(".dummy-select-or-edit .logo-select-wrapper").find(".upload-wrapper").attr("onclick", openSVGEditor(event, type));
                // $selectOrEdit = $(".dummy-select-or-edit .logo-select-wrapper").prop("outerHTML");
                // var text = ".onboarding-logo-preview#" + type + "-preview"
                // console.log(text, $(".onboarding-logo-preview#" + type + "-preview"))
                // $selectOrEdit = $(".onboarding-logo-preview#" + type + "-preview").prop("outerHTML");

                if (!svg_string.includes("Infinity")) { // empty
                    var innerHtml = $("#"+type+"-preview")[0].innerHTML;
                    var regex = new RegExp(`<svg.*?</svg>`, "g");
                    innerHtml = innerHtml.replace(regex, ``);

                    $("#"+type+"-preview")[0].innerHTML = svg_string + innerHtml;
                    $("#"+type+"-preview").siblings("input").addClass("touched svg-string");
                    $("#"+type+"-preview").find(".logo-select-wrapper").addClass("floating");

                    $("#svg-editor-popup-wrpr").addClass("d-none");

                    // $("#"+type+"-preview").siblings('[type="file"]').addClass("touched");
                    uploadLogo($("#"+type+"-preview").closest(".onboarding-logo-inner"), true);
                    addTabState("logo", "draft");
                }

                // updateLogos();
               
                // var svg_blob = new Blob([svg_string], {
                //     type: "image/svg+xml;charset=utf-8"
                // });
                // var svg_url = URL.createObjectURL(svg_blob);
                // var downloadLink = document.createElement("a");
                // downloadLink.href = svg_url;
                // downloadLink.download = "svg.svg";
                // console.log(downloadLink)
                // document.body.appendChild(downloadLink);
                // downloadLink.click();
                // document.body.removeChild(downloadLink);
                // this.selectedElements = [];
                // console.log(this.selectedElements);
            }
        },

        updated() {
            var self = this;
           
            try {
                this.original_svg = this.$refs.container.innerHTML;

                window.svgDragSelectOptions = {
                    svg: $("#svg-editor-popup-wrpr svg")[0],
                    onSelectionStart: function (selectionStart) {
                        const selectedElements = selectionStart.svg.querySelectorAll('[data-selected]')
                        for (let i = 0; i < selectedElements.length; i++) {
                            selectedElements[i].removeAttribute('data-selected')
                        }
                        self.floatingElements = [];
                    },
                    onSelectionEnd: function (selectionEnd) {
                        if (selectionEnd.dragAreaInClientCoordinate.height<5 && selectionEnd.dragAreaInClientCoordinate.width<5) {
                            var current_element = selectionEnd.selectedElements[0]; // TODO: - handle current_element null
                            var current=self.selectedElements.indexOf(current_element) !== -1;
                            if (current) {
                                current_element.removeAttribute('data-selected');
                                var position = self.selectedElements.indexOf(current_element);
                                self.selectedElements[position] = self.selectedElements[ self.selectedElements.length - 1 ];
                                self.selectedElements.pop();
                            } else {
                                current_element.setAttribute('data-selected', 'true');
                                self.selectedElements.push(current_element);
                            }
                            self.selectedElements.forEach(path => {
                                path.setAttribute('data-selected', 'true');
                            });
                        } else {
                            self.selectedElements = [];
                            selectionEnd.selectedElements.forEach(element => {
                                element.setAttribute('data-selected', 'true');
                                self.selectedElements.push(element);
                            });
                        }
                    },
                    onSelectionChange: function (selectionChange) {
                        selectionChange.newlyDeselectedElements.forEach(function (element) {
                            element.removeAttribute('data-selected')
                        })
                        selectionChange.newlySelectedElements.forEach(function (element) {
                            element.setAttribute('data-selected', '')
                        })
                        selectionChange.newlySelectedElements.forEach(element => {
                        
                        });
                    },
                    selector: "intersection",
                }

                svgDragSelect(svgDragSelectOptions)
               

            }
            catch (e) {
                console.log(e);
            }
        },

        mounted(){
            this.init()
        }

