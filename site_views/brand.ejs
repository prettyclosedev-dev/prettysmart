    <script>

        // $(document).on('click', '.open-svg-editor', function(e){
        //    $(e.target).css('background-color', e.target.value);
        // })

        function setAskForHelpTab(tab) {
            $("[data-help-tab]").addClass("d-none")
            $(`[data-help-tab=${tab}]`).removeClass("d-none")
        }

        function openSVGEditor(e, type) {
            console.log("CLICKED OPEN EDITOR")
            e.preventDefault()

            $('#svg-editor-popup-wrpr').removeClass("d-none").attr("data-type", type)
            
            // Reset any previous selection/overlay from other types
            try {
                const svg = $("#svg-editor-popup-wrpr svg")[0];
                if (svg) {
                    const overlay = svg.querySelector('#selection-overlay');
                    if (overlay) overlay.remove();
                    const selected = svg.querySelectorAll('[data-selected]');
                    selected.forEach(el => el.removeAttribute('data-selected'));
                }
                if (window.app) {
                    window.app.selectedElements = [];
                    window.app.modified_svg = '';
                    window.app.original_svg = '';
                }
            } catch(_) {}

            $("#editor-desc").find('span').remove();
            $("#editor-desc").append(`<span>${type}</span>`);
            $("#editor-generate").find('span').remove();
            $("#editor-generate").append(`<span> ${type}</span>`);
            
            window.app.init();
        }

        $(document).on('input', '#primary', function(e){
           $(e.target).css('background-color', e.target.value);
        })

        $(document).on('input', '#secondary', function(e){
           $(e.target).css('background-color', e.target.value);
        })

        $(document).ready(function() {
            $(".upload-wrapper").addClass('<%= (brand && brand.logos && brand.logos.logo ? "":"d-none") %>');

            $(".logo").on('change', function() {
                $(".upload-wrapper").removeClass('d-none');
            })
        })

        $(document).on('click', '[data-tab]', function(e){
            var $target = $(this);
            var tab = $(this).data('tab');
            
            // Check if there are unsaved changes
            if ($('.save-brand').hasClass('save-brand-active')) {
                // Prevent default tab switch
                e.preventDefault();
                
                // Mark the button as auto-save and store the tab to switch to
                $('[data-save-brand]').data('auto-save', true).data('next-tab', tab);
                
                // Trigger the save
                $('[data-save-brand]').click();
                
                // After save completes, switch tabs
                // Wait a bit for uploads to complete
                setTimeout(function() {
                    $target.addClass('selected').siblings().removeClass("selected");
                    $('[data-tab-content="'+tab+'"]').removeClass('d-none').siblings().addClass('d-none');
                }, 500);
            } else {
                // No unsaved changes, just switch tabs normally
                $target.addClass('selected').siblings().removeClass("selected");
                $('[data-tab-content="'+tab+'"]').removeClass('d-none').siblings().addClass('d-none');
            }
        })
    </script>

   
<script>
    function strictIntersectionSelector(context) {
        const dragAreaInSvgCoordinate = context.dragAreaInSvgCoordinate
        return context.getIntersections().filter(function (element) {
            if (context.pointerEvent.target === element) {
                return true
            }
            if (!(element instanceof SVGPathElement)) {
                // strictly check only <path>s.
                return true
            }
            for (let i = 0, len = element.getTotalLength(); i <= len; i += 4 /* arbitrary */) {
                const point = element.getPointAtLength(i)
                const x = point.x
                const y = point.y
                if (
                    dragAreaInSvgCoordinate.x <= x && x <= dragAreaInSvgCoordinate.x + dragAreaInSvgCoordinate.width &&
                    dragAreaInSvgCoordinate.y <= y && y <= dragAreaInSvgCoordinate.y + dragAreaInSvgCoordinate.height
                ) {
                    return true
                }
            }
            return false
        })
    }
</script>

