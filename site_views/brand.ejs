<%- include('partials/header', {async: true}); %>
    <link rel="stylesheet" href="/static/css/new-brand.css?<%=Date.now()%>">
    <style>
        @font-face {
            font-family: "<%= brand.fonts.Regular.name %>";
            <% if (!brand.fonts.Regular.google) { %> src: url("/files/<%= user.account.id %>/fonts/<%= brand.fonts.Regular.path %>") format('truetype'); <% } %>
            font-weight: normal;
            font-style: normal;
        }

        @font-face {
            font-family: "<%= brand.fonts.Bold.name %>";
            <% if (!brand.fonts.Regular.google) { %> src: url("/files/<%= user.account.id %>/fonts/<%= brand.fonts.Bold.path %>") format('truetype'); <% } %>
            font-weight: bold;
            font-style: normal;
        }

        @font-face {
            font-family: "<%= brand.fonts.Italic.name %>";
            <% if (!brand.fonts.Regular.google) { %> src: url("/files/<%= user.account.id %>/fonts/<%= brand.fonts.Italic.path %>") format('truetype'); <% } %>
            font-weight: normal;
            font-style: italic;
        }

        @font-face {
            font-family: "<%= brand.fonts.BoldItalic.name %>";
            <% if (!brand.fonts.Regular.google) { %> src: url("/files/<%= user.account.id %>/fonts/<%= brand.fonts.BoldItalic.path %>") format('truetype'); <% } %>
            font-weight: bold;
            font-style: italic;
        }

        .userRegularFont {
            font-family: "<%= brand.fonts.Regular.name %>";
            font-weight: normal;
            font-style: normal;
        }

        .userBoldFont {
            font-family: "<%= brand.fonts.Bold.name %>";
            font-weight: bold;
            font-style: normal;
        }

        .userItalicFont {
            font-family: "<%= brand.fonts.Italic.name %>";
            font-weight: normal;
            font-style: italic;
        }

        .userBoldItalicFont {
            font-family: "<%= brand.fonts.BoldItalic.name %>";
            font-weight: bold;
            font-style: italic;
        }
    </style>
    <script>
        $(document).ready(function() {
            var brand = <%- JSON.stringify(brand) %>;
            var fonts = brand && brand.fonts;
            if (fonts && Object.keys(fonts).length) {
                Object.keys(fonts).forEach(function(key) {
                    const {name, path, google} = fonts[key];
                    if (google) {
                        $('head').append(`<link href='https://fonts.googleapis.com/css?family=${name.replace(/([A-Z][a-z0-9]+)/g, '+$1 ').replace(/\s{2}/g," ").trim().replace(/ /g, "")}' rel='stylesheet' type='text/css'>`)
                        $(`.user${key}Font`).css({
                            'font-family': name.replace(/([a-z])([A-Z])/g, '$1 $2'), 
                            'font-weight': key === 'Italic'
                                    ? 'normal'
                                    : key === 'BoldItalic'
                                    ? 'bold'
                                    : key.toLowerCase(), 
                            'font-style': key === 'Italic' || key === 'BoldItalic'
                                    ? 'italic'
                                    : 'normal'
                        });
                    } /*else {
                        $("head").append(`<style type='text/css'>
                            @font-face {
                                font-family: 'user${key}Font';
                                src: url('/files/${user.account.id}/fonts/${path}') format('truetype');
                                font-weight: ${
                                name === "Italic"
                                    ? "normal"
                                    : name === "BoldItalic"
                                    ? "bold"
                                    : name.toLowerCase()
                                };
                                font-style: ${
                                name === "Italic" || name === "BoldItalic"
                                    ? "italic"
                                    : "normal"
                                };
                            }
                        </style>`);
                        $(`.user${key}Font`).css('font-family', `user${key}Font`);
                    }*/
                });
            }
        });
    </script>
