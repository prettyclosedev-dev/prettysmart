    document.querySelectorAll('.color').forEach(input => {
    input.addEventListener('click', (e) => {
        // Remove existing tooltip if any
        document.querySelectorAll('.color-tooltip').forEach(t => t.remove());

        // Create tooltip
        const tooltip = document.createElement('div');
        tooltip.className = 'color-tooltip';
        tooltip.textContent = 'Use the eyedropper tool to pick a color — hover over the part of your logo you want to pick a color from.';
        document.body.appendChild(tooltip);

        // Position beside the input
        const rect = e.target.getBoundingClientRect();
        tooltip.style.left = `${rect.left - tooltip.offsetWidth - 10}px`; // 10px gap on the left
        tooltip.style.top = `${rect.bottom + 135}px`;

        // Fade in
        requestAnimationFrame(() => tooltip.style.opacity = '1');

        // Function to close tooltip and remove all listeners
        const closeTooltip = () => {
            if (tooltip && tooltip.parentNode) {
                tooltip.style.opacity = '0';
                setTimeout(() => {
                    if (tooltip && tooltip.parentNode) {
                        tooltip.remove();
                    }
                }, 200);
            }
            // Remove all event listeners
            input.removeEventListener('blur', closeTooltip);
            window.removeEventListener('scroll', closeTooltip);
            document.removeEventListener('scroll', closeTooltip);
        };

        // Remove tooltip when color picker closes (on blur)
        input.addEventListener('blur', closeTooltip);

        // Remove tooltip on window scroll
        window.addEventListener('scroll', closeTooltip, true);
        
        // Also listen for scroll on document (for capturing phase)
        document.addEventListener('scroll', closeTooltip, true);

        // Auto-hide after 3 seconds
        setTimeout(() => {
            closeTooltip();
        }, 5000);
    });
    });
</script>

