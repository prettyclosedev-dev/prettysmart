    <script>

      let swiper;
      setTimeout(() => {
        let showPerView
        if (window.innerWidth > 1200) {
          showPerView = 3;
         } else if (window.innerWidth > 800) {
          showPerView = 2;
        } else {
          showPerView = 1;
        }
         swiper = new Swiper('.swiper', {
                slidesPerView: showPerView,
                spaceBetween:14,
                mousewheel: true,
                loop: true,
            });
      }, 0);

      

      window.addEventListener("resize", () => {
        console.log("RESIZING",swiper.params.slidesPerView);
        if (window.innerWidth > 1200) {
          swiper.params.slidesPerView = 3;
          swiper.update();
         } else if (window.innerWidth > 800) {
          swiper.params.slidesPerView = 2;
          swiper.update();
        } else {
          swiper.params.slidesPerView = 1;
          swiper.update();
        }
      });
          //  swiper = new Swiper('.swiper', {
          //       slidesPerView: 3,
          //       spaceBetween:14,
          //       mousewheel: true,
          //       loop: true,
          //   });
      
    </script>

<script>
  function setMobileNav() {
    if (window.innerWidth < 840) {
    console.log("mobile nav",document.getElementById("navs-wrpr"));
    $("#navs-wrpr").toggleClass("show");
    $(".navs-overlay").toggleClass("show");
    }
  }
</script>
  </head>

  <% const renderSignUp = (inverted) => { %>
  <a href='<%= authenticated ? "templates" :  "signup" %>' class="fs14 menu-button button-text <%= inverted ? 'sign-up-inverted' : 'sign-up' %>">
    <i class="fa-solid <%= authenticated ? 'fa-icons' : 'fa-plus'%>"></i><%= authenticated ? "Go to App" :  "Sign Up" %>
  </a>
  <% } %>

  <% const renderDash = () => { %>
  <hr class="dash" />
  <% } %>

  <% const renderHowItem = (icon, title, desc, inverted) => { %>
  <div class="<%= inverted ? 'how-item-inverted' : 'how-item' %>">
    <%= inverted ? renderDash() : null %>
    <i class="<%= icon %> fa-xl" style="<%= inverted ? 'color:  white;' : 'color: #db3965;' %>"></i>
    <p class="semi-large-text how-title" style="<%= inverted ? 'color:  white;' : 'color: black;' %>"><%= title %></p>
    <p class="plain-text how-text" style="<%= inverted ? 'color:  white;' : 'color: black;' %>"><%= desc %></p>
  </div>
  <% } %>

  <% const renderBanner = (text, imgId, imgSource) => { %>
  <section class="section back-red custom-banner">
      <div class="section-content" style="border-bottom: none;">
        <div class="row-space wowo fadeInUp inner-content" style="width: 100%;">
          <div class="text-btn-wrpr">
            <% if(text.header) { %>
            <p class="large-text huge-text" style="color: white; margin-bottom: 7vh; line-height: 1.1;">
              <%- text.header %>
            </p>
            <% } else { %>
            <p class="large-text huge-text" style="color: white; margin-bottom: 7vh; line-height: 1.1;">
              <%- text %>
            </p>
            <% } %>
            <% if(text.subheader) { %>
            <p class="large-text" style="color: white; margin-bottom: 7vh; line-height: 1.1;">
              <%- text.subheader %>
            </p>
            <% } %>
            <%= renderSignUp(true); %>
          </div>
          <img id="<%= imgId %>" src="<%= imgSource %>" />
        </div>
      </div>
    </section>
  <% } %>

<% const renderTestimonial = (text, testifier, brand) => { %>
  <div class="testimonial">
    <p class="plain-text"><%= text %></p>
    <p class="plain-text" style="font-weight: 600; margin-top: 1vw; user-select: none; cursor: context-menu"><%= testifier %><br><%= brand %></p>
  </div>
<% } %>

  <body id="landing-page">
    <section id="header" class="row-space padding-horizontal">
      <a href="/"><img id="logo" src="/site_static/images/logo.svg" alt="Prettyclose"/></a>
      <i onclick="setMobileNav()" class="fa-solid fa-ellipsis mobile-nav-open" style="color: #db3965; font-size: 18px;"></i>
      <div class="row-space navs-wrpr" id="navs-wrpr">
        <div class="close-wrpr">
          <i onclick="setMobileNav()" class="fa-solid fa-xmark"></i>
        </div>
        <!-- <div id="pricing-anchor" class="anchor"></div> -->
        <a href="#why-anchor" class="menu-button-text button-text" onclick="setMobileNav()"><p>Why</p></a>
        <a href="#pricing-anchor" class="menu-button-text button-text" onclick="setMobileNav()"><p>Pricing</p></a>
        <a href="#faq-anchor" class="menu-button-text button-text" onclick="setMobileNav()"><p>FAQ</p></a>
        <div id="sign-up-in" class="row-space login-btns-wrpr">
          <div class="margin-horizontal-10"><%= renderSignUp(); %></div>
          <% if (!authenticated) { %>
            <div class="margin-horizontal-10">
              <a href="login" class="fs14 menu-button button-text sign-in">
                <i class="fa-solid fa-sign-in"></i>Sign In
              </a>
            </div>
          <% } %>
        </div>
      </div>
      <div class="navs-overlay"></div>
    </section>
    <section id="intro" class="row-space padding-horizontal">
      <div id="intro-text" class="wowo fadeInUp">
        <p class="tiny-red margin-bottom-2">Real Estate design in seconds.</p>
        <p class="large-text">
          Grow your real estate business on social media.
        </p>
        <p class="large-text">
          Generate on-brand posts in seconds for any platform.
        </p>
        <br/>
        <p class="medium-text margin-bottom-2">
          Become a voice that matters in your area with Prettyclose. Gain views and followers with polished posts and attract new customers - without the effort!
        </p>
        <br/>
        <%= renderSignUp(); %>
        <br/>
        <br/>
        <br/>
        <p class="tiny-red tiny-text" style="font-size: 0.7rem;">
          Start your 7 day free trial now—no charge until after the first week!
        </p>
      </div>
      <img
        id="img-1"
        class="wowo fadeInRight"
        src="/site_static/images/landing/1.png"
      />
    </section>
    <section id="works" class="section works-with">
      <div class="section-content">
        <p class="tiny-red section-title">Works With</p>
        <img
          id="img-2"
          class="wowo fadeInUp"
          src="/site_static/images/landing/2.png"
          style="object-fit: contain; width: 100%; height: auto;"
        />
      </div>
    </section>
    <section id="why" class="section">
      <div id="why-anchor" class="anchor"></div>
      <div class="section-content">
        <p class="tiny-red section-title">Why Prettyclose?</p>
        <div class="grid wowo fadeInUp why-pretty-smart-grid">
          <div class="sec">
            <img src="/site_static/images/landing/seamless-design.svg" style="z-index: 1;" />
            <h5 class="ffp">Fully Branded</h5>
            <p class="ffp">Every post uses your brand colors and logos for a polished look.</p>
          </div>

          <div class="sec">
            <img src="/site_static/images/landing/ai-copywriter.svg" style="z-index: 1;" />
            <h5 class="ffp">Your information</h5>
            <p class="ffp"> Add your name and contact info, or photos to leverage your audience</p>
          </div>

          <div class="sec">
            <img src="/site_static/images/landing/free-stock-photos.svg" style="z-index: 1;" />
            <h5 class="ffp">Unlimited Posts</h5>
            <p class="ffp">Enjoy endless ready-to-use content for your social media.</p>
          </div>

          <div class="sec">
            <img src="/site_static/images/landing/tons-of-templates.svg" style="z-index: 1;" />
            <h5 class="ffp">Template library</h5>
            <p class="ffp">No inspiration for your next post? Use one of your 500+ templates to keep your momentum going</p>
          </div>

          <div class="sec">
            <img src="/site_static/images/landing/super-scalable.svg" style="z-index: 1;" />
            <h5 class="ffp">Post Categories</h5>
            <p class="ffp">Generate a post about an open house, a recently sold unit, a new listing, current rates, or more, all in under a minute!</p>
          </div>

          <div class="sec">
            <img src="/site_static/images/landing/easy-editor.svg" style="z-index: 1;" />
            <h5 class="ffp">Emails and printables</h5>
            <p class="ffp">Generate other branded assets including emails, letterheads, business cards and more on the same platform.</p>
          </div>
        </div>
      </div>
    </section>
    <section id="see" class="section">
      <div class="section-content" style="position: relative">
        <p class="tiny-red section-title">See what we can do</p>
        <div class="row-no-space">
          <div class="video-mask wowo fadeInUp">
            <video id="video" controls>
              <source
                src="/static/videos/explainer.mp4"
                type="video/mp4"
                frameborder="0" 
                allow="accelerometer; encrypted-media; gyroscope; picture-in-picture" 
                allowfullscreen 
                allow="autoplay"
                muted
              />
              Your browser does not support HTML video.
            </video>
          </div>
        </div>
      </div>
    </section>
    <section id="how" class="section d-none">
       <div id="how-anchor" class="anchor"></div>
      <div class="section-content">
        <p class="tiny-red section-title">How it works</p>
        <div class="wowo fadeInLeft" id="how-it-works">
          <%= renderHowItem("fa-solid fa-upload", "Upload your brand", "Upload your logo, font, and colors when you create your account"); %>
          <%= renderHowItem("fa-solid fa-keyboard", "Tell us what you need", "Then, tell us what you're looking for whenever you need a new post."); %>
          <%= renderHowItem("fa-solid fa-face-explode", "Create your post", "You'll get fresh copy and design in seconds!", true); %>
        </div>
      </div>
    </section>

    <section id="testimonials" class="section">
      <div id="testimonials-anchor" class="anchor"></div>
      <div class="section-content" style="border-bottom: none;">
        <p class="tiny-red section-title">Testimonials</p>
        <div class="row-space wowo fadeInUp" style="width: 100%">
          <div class="swiper wowo fadeInUp" style="width: 100%;">
              <div class="swiper-wrapper">
                <div class="swiper-slide" style="width: 35%;">
                    <% renderTestimonial("I used a fantastic agency for my social media posts. However, I waited days for every post. I was ready to hire an in-house designer to get my design done fast - when a friend recommended PrettyClose. I now spend under 3 minutes per post, do it myself, my audience loves them and they help me sign new deals.", "P. Schwartz", "Castling"); %>
                </div>
                <div class="swiper-slide" style="width: 35%;">
                    <% renderTestimonial("Time in business is money. That is why I love PrettyClose, and I get beautiful designs done in seconds. The copy and design are impressive; it took my brand to the next level.", "Ari Greenfeld", "GreenTouch Media"); %>
                </div>
                <div class="swiper-slide" style="width: 35%;">
                    <% renderTestimonial("As a business owner, I really, really appreciate PrettyClose. There is absolutely no reason to hire a designer or copywriter when you can get it done for a fraction of the time and price.", "Mel Schlesinger", ""); %>
                </div>
              </div>
          </div>
        </div>
      </div>
    </section>
    <% renderBanner({header: "Build your social media presence and get inbound leads every day."}, "img-4", "/site_static/images/landing/4.png") %>
    <section id="pricing" class="section">
      <div id="pricing-anchor" class="anchor"></div>
      <div class="section-content">
        <p class="tiny-red section-title">Pricing</p>
        <p class="large-text section-title wowo fadeInLeft">It's a small price to pay.</p>
        <div class="wowo fadeInRight" style="display: flex; flex-direction: column; width: 100%; align-items: center;">
          <script>
            var authenticated = <%= authenticated  %>;
            $(document).on('click', "#plan-button", function(e) {
              window.location.href = authenticated ? "generator" : "signup"
            });
            $(document).on('change', '[type="radio"]', function(e) {
                  var new_interval = $(this).attr("id").includes("month") ? 'month' : 'year'
                  $.post(`/landing/interval/${new_interval}`, function(data) {
                      $('.price-items').html($(data).find('.price-items').html());
                  });
              });
          </script>
          <% if (typeof products != "undefined") { %>
            <div class="seg-wrapper" style="display: flex; align-self: center;">
              <%- include('partials/segment-control', {async: true, options: [{value: "Monthly", id: "month", selected: interval === "month"}, {value: "Yearly 20% off", id: "year", selected: interval === "year"}], inverted: false, segmentID: "land-seg"}); %>
            </div>
            <%- include('partials/plans-items', {async: true, onGray: false, products: products.data, interval}); %>
          <% } %>
        </div>
      </div>
    </section>
    <section id="faq" class="section">
      <div id="faq-anchor" class="anchor"></div>
      <div class="section-content" style="border-bottom: none;">
        <p class="tiny-red section-title">Frequently asked questions</p>
        <div class="faq-content wowo fadeInLeft">
          <%
            const faqs = [,
            {
              title: "I need a specific post or flyer, but I don't see it on the dashboard. Can you add it?", 
              desc: "We're always updating with new designs and concepts, and we’d love to hear your suggestions. Let us know what you're looking for, and we may be able to add it!"
            }, 
            {
              title: "Do you have a minimum commitment?", 
              desc: "We offer a month to month service where you can cancel anytime to prevent future billing! However, for even more value savings, we do offer longer term memberships as well."
            },
            {
              title: "Do you offer refunds?", 
              desc: "No, we do not offer refunds. You can always cancel in the first seven days of your free trial not to be billed at all, otherwise you can cancel during any time and you will not be billed at the next billing cycle."
            }]
          %>
          <% faqs.map(faq => { %>
            <details class="details">
              <summary class="summary"><%= faq.title %></summary>
              <p><%= faq.desc %></p>
            </details>
            <br />
            <br />
          <% }) %>
        </div>
      </div>
    </section>
    <% renderBanner("Get agency level posts<br>Let them think you have an<br>in-house social media genius.", "img-5", "/site_static/images/landing/5.png") %>
    <%- include('partials/footer', {async: true, authenticated}); %>
  </body>

  <script>
    $(document).ready(function () {
      // add static $45 per agent
      $(".price-item-title")[0].innerHTML += ("<br/><span>&nbsp;</span> ")
      $(".price-item-title")[1].innerHTML += ("<br/>$45 per agent")
    })
  </script>
</html>
