<%- include('partials/clip-studio-header', {async: true}); %>
<style>
  .ui-autocomplete-loading {
    background: white url("/static/images/ui-anim_basic_16x16.gif") right center no-repeat;
  }
</style>
<link rel="stylesheet" href="/static/css/jquery-ui.min.css">
<link rel="stylesheet" href="/static/css/jquery.fontpicker.css">
<script src="/static/js/jquery-ui.min.js"></script>
<div class="df page-wrapper df ffp">
  <p>..</p>
  <div class="page-content">
    <%- include('clip-form', {async: true}); %>

    <div class="templates-page">
      <div class="page-content-wrapper">
        <%
                    function isAllowedDownload(file_name) {
                        return (
                            (plan_name && (plan_name !== "Starter" || downloads_left > 0) && !payment_failed) ||
                            file_name.includes("_Starter")
                        );
                    }
                %>

        <div class="list-wrapper d-none">
          <div id="templates_container">
            <% templates.forEach((templateType, index) => { %>
            <div id="<%= templateType._id %>" class="item-wrapper">
              <div class="df aic item-header">
                <p><%-templateType.name%></p>
                <div class="mla">
                  <div class="orientation-selection-wrapper">
                    <% 
                                            function sizeOptions(selectedRow) {
                                                return selectedRow.sizes.map(function (size, index) {
                                                    return {value: size.name, id: size._id, selected: size._id === selectedRow.default_size, row: selectedRow, size};
                                                }) 
                                            }
                                        %>
                    <% if (templateType.sizes) { %>
                    <%- include('partials/segment-control', {async: true, options: sizeOptions(templateType), inverted: false, segmentID: index + "-seg"}); %>
                    <% } %>
                  </div>
                </div>
              </div>

              <div class="swiper" style="width: 100%;">
                <div class="swiper-wrapper">
                  <!-- Slides -->
                  <% templateType.templates.forEach((template,idx) => {%>
                  <div class="swiper-slide" style="margin-right: 14px;">
                    <div class="template">
                      <%- include('partials/template', {async: true, template:template}); %>
                      <div class="favorite-wrapper">
                        <span class="like-icon">
                          <div class="heart-animation-1"></div>
                          <div class="heart-animation-2"></div>
                        </span>
                        Favorite
                      </div>
                      <% if (template.template_title.includes("_Starter")) { %>
                      <div class="tag fs14 ttuc" style="background-color: #db3965;">Starter!</div>
                      <% } %>

                      <div class="download-wrapper">

                        <!--  -->
                        <div class="download-button primary-btn btn-group dropup" style="display: inline-flex;">
                          <button class="btn btn-med download-button-item" value="jpg" type="button" <% if (!isAllowedDownload(template.template_title)) { %> style="justify-content: center;" onclick="location.href='/plans';" <% } %>>
                            <%= isAllowedDownload(template.template_title) ? 'Download JPG' : 'Upgrade plan' %>
                          </button>
                          <% if (isAllowedDownload(template.template_title)) { %>
                          <button type="button" class="btn btn-med  dropdown-toggle dropdown-toggle-split" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                            <span class="sr-only">Select download type</span>
                            <i class="fa-regular fa-chevron-down"></i>
                          </button>
                          <div class="dropdown-menu dropdown-menu-right">
                            <button class="dropdown-item download-button-item" value="png">Download PNG</button>
                            <button class="dropdown-item download-button-item" value="pdf">Download PDF</button>
                            <button class="dropdown-item download-button-item" value="pdf_flattened">Download PDF Flattened</button>
                          </div>
                          <% } %>
                        </div>
                        <!--  -->
                      </div>
                    </div>
                  </div>
                  <%})%>
                </div>
                <div class="swiper-button-prev hidden"></div>
                <div class="swiper-button-next hidden"></div>
              </div>
            </div>
            <%})%>
          </div>

          <div class="single-swiper-wrapper swiper-wrapper">
            <!-- Slides -->
            <% row.templates.forEach((template,idx) => {%>
            <div class="swiper-slide">
              <div class="template">
                <%- include('partials/template', {async: true, template:template}); %>
                <div class="favorite-wrapper">
                  <span class="like-icon">
                    <div class="heart-animation-1"></div>
                    <div class="heart-animation-2"></div>
                  </span>
                  Favorite
                </div>
                <% if (template.template_title.includes("_Starter")) { %>
                <div class="tag fs14 ttuc" style="background-color: #db3965;">Starter!</div>
                <% } %>

                <div class="download-wrapper">
                  <!--  -->
                  <div class="download-button primary-btn btn-group dropup" style="display: inline-flex;">
                    <button class="btn btn-med download-button-item" value="jpg" type="button" <% if (!isAllowedDownload(template.template_title)) { %> style="justify-content: center;" onclick="location.href='/plans';" <% } %>>
                      <%= isAllowedDownload(template.template_title) ? 'Download JPG' : 'Upgrade plan' %>
                    </button>
                    <% if (isAllowedDownload(template.template_title)) { %>
                    <button type="button" class="btn btn-med  dropdown-toggle dropdown-toggle-split" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                      <span class="sr-only">Select download type</span>
                      <i class="fa-regular fa-chevron-down"></i>
                    </button>
                    <div class="dropdown-menu dropdown-menu-right">
                      <button class="dropdown-item download-button-item" value="png">Download PNG</button>
                      <button class="dropdown-item download-button-item" value="pdf">Download PDF</button>
                      <button class="dropdown-item download-button-item" value="pdf_flattened">Download PDF Flattened</button>
                    </div>
                    <% } %>
                  </div>
                  <!--  -->
                </div>
              </div>
            </div>
            <%})%>
          </div>
        </div>
      </div>
    </div>
    <div class="df aic studio-footer">
      <div class="df aic">
        <button class="df aic edit-propmpt-button" onclick="$('.clips-form-page').removeClass('d-none')"><img height="24" width="24" src="/site_static/images/clips-generate.svg" alt="">Edit Prompt</button>
      </div>

      <div class="df aic credits-available">
        <div class="df aic sec">
          <% if(typeof generates_left != "undefined" && generates_left !== "Unlimited") { %>
          <p class="generates number"><%= typeof generates_left != "undefined" ?generates_left: undefined %></p>
          <div>
            <i class="fa-regular fa-microchip-ai"></i>
            <p class="val">Generates Available</p>
          </div>
          <% } %>
        </div>
        <div class="df aic sec">
          <% if(typeof downloads_left != "undefined" && downloads_left !== "Unlimited") { %>
          <p class="number"><%= typeof downloads_left != "undefined" ?downloads_left: undefined %></p>
          <!-- downloads_left -->
          <div>
            <i class="fa-regular fa-cloud-arrow-down"></i>
            <p class="val">Downloads Available</p>
          </div>
          <% } %>
        </div>


      </div>
      <div class="aic">
        <button class="d-none aic regenerate-button" onclick="generateClyps()"><img height="24" width="24" src="/site_static/images/clips-regenerate.svg" alt="">Regenerate Results</button>
      </div>
    </div>
  </div>


  <%- include('partials/export-template', {async: true}); %>
</div>


<script>
  var swiper = new Swiper('.swiper', {
    slidesPerView: 'auto',
    spaceBetween: 14,
    mousewheel: true,
    observer: true,
    observeParents: true,
    rebuildOnUpdate: true,
    navigation: {
      nextEl: '.swiper-button-next',
      prevEl: '.swiper-button-prev',
    },
  });

  $(".item-wrapper").hover(function() {
    $(".swiper-button-prev").removeClass("hidden");
    $(".swiper-button-next").removeClass("hidden");
  }, function() {
    $(".swiper-button-prev").addClass("hidden");
    $(".swiper-button-next").addClass("hidden");
  });
</script>

<script>
  $('.favorite-wrapper').on('click', function(e) {
    var user = <%- JSON.stringify(user) %>;
    if (!user.account.plan_id) {
      alert("You need a paid account to save your favorite templates.")
    } else {
      $(this).toggleClass('liked');
      if ($(this).hasClass("liked")) {
        onAddFavorite($(this))
      } else {
        onRemoveFavorite($(this))
      }
    }

    // setTimeout(() => {
    //   $(e.target).removeClass('liked')
    // }, 1000)
  });

  function isAllowedDownload(file_name) {
    var plan_name = <%- JSON.stringify(plan_name) %>
    var payment_failed = <%- JSON.stringify(payment_failed) %>
    var downloads_left = <%- JSON.stringify(downloads_left) %>

    return (plan_name && (plan_name !== "Starter" || downloads_left > 0) && !payment_failed) || file_name.includes("_Starter");
  }
</script>

<script>
  var TOKEN = '<%=user.token.access_token%>';
  var draft_brand = <%- JSON.stringify(brand) %>;
</script>
<script src="/static/js/jquery.fontpicker.js?<%=Date.now()%>"></script>
<script src="/static/js/templates.js?<%=Date.now()%>"></script>
<script src="/static/js/brand.js?<%=Date.now()%>"></script>
<script src="/static/js/loader.js"></script>

</body>

</html>